@tool
class_name Cometling
extends Node3D
## One Cometling (PT: Cometinho), the chibi species that crews MARGIN's rockets.
## Rig: scenes/npc/creature.tscn (generated by tools/creature_gen.py): a skeleton-free
## hierarchy of Node3D pivots, one voxel mesh per limb. This script drives every pivot
## procedurally each frame (no AnimationPlayer, no bones):
##   - idle: breathing, bob, blinking (sometimes double), glancing, antenna pulse
##   - walking: squash & stretch steps, arm swing, body sway; set_move_velocity()
##   - secondary motion: ears, antenna, tail and scarf on damped springs (overlap)
##   - look-at: head turns toward a point (rocket, camera, a friend), body follows a bit
##   - loop actions: sit, look_up, work_hammer, work_scan, carry, clipboard, talk, dance
##   - one-shots on top: wave, cheer, jump, surprise, nod
## Hangars call react("part_placed") etc. Every Cometling also listens to the
## NpcEvents bus (src/npc/npc_events.gd) when listen_to_events is on.

signal action_finished(action: String)

const ROLES := ["ground", "pilot", "engineer", "scientist"]
const LOOP_ACTIONS := ["idle", "sit", "look_up", "work_hammer", "work_scan", "carry", "clipboard", "talk", "dance"]
const ONESHOTS := {"wave": 2.2, "cheer": 2.4, "jump": 1.0, "surprise": 1.1, "nod": 0.9, "spin": 1.2}
const EMOTES := ["heart", "star", "exclaim", "question", "note", "wrench", "rocket", "zzz",
	"idea", "sweat", "happy", "sparkle", "chat", "fire", "check", "planet"]
## Role -> antenna glow colour (palette: ACCENT, HAZARD, ACCENT_2, SUCCESS).
const ROLE_GLOW := {"pilot": Color("#f59a36"), "engineer": Color("#f2b705"),
	"scientist": Color("#5fb0d8"), "ground": Color("#7ee08a")}

@export_enum("ground", "pilot", "engineer", "scientist") var role: String = "ground":
	set(v):
		role = v
		_apply_role()
@export var body_color := Color("#bfe9ff"):
	set(v):
		body_color = v
		_apply_colors()
@export var spot_color := Color("#ffcc55"):
	set(v):
		spot_color = v
		_apply_colors()
## Leave transparent (alpha 0) to use the role colour.
@export var glow_color := Color(0, 0, 0, 0):
	set(v):
		glow_color = v
		_apply_colors()
@export var body_material: Material
## Randomizes rhythm, blinks and idle habits so a crowd never moves in sync.
@export var personality_seed := 0
## Loop action at start (idle, sit, look_up, work_hammer, work_scan, carry, clipboard, talk, dance).
@export var start_action := "idle"
@export var listen_to_events := true
@export var animate_in_editor := false
## Meshes are hidden beyond this camera distance (metres, GeometryInstance3D visibility range).
@export var cull_distance := 170.0
## Animation runs at full rate closer than this; further away it is updated less often.
@export var lod_distance := 45.0

## Point the head should look at (world space) and how much (0..1).
var look_target := Vector3.ZERO
var look_weight := 0.0
var paused := false

var _t := 0.0
var _rng := RandomNumberGenerator.new()
var _speed := 0.0            # m/s, model units (already divided by scale)
var _speed_s := 0.0
var _move_local := Vector3.ZERO
var _phase := 0.0
var _loop := "idle"
var _loop_t := 0.0
var _loop_w := 0.0
var _prev_loop := "idle"
var _prev_loop_w := 0.0
var _shot := ""
var _shot_t := 0.0
var _shot_len := 0.0
var _queue: Array[String] = []
var _blink_t := -1.0
var _blink_next := 2.0
var _blink_double := false
var _glance := Vector2.ZERO
var _glance_target := Vector2.ZERO
var _glance_next := 1.0
var _look_cur := Vector2.ZERO
var _emote_t := -1.0
var _emote_len := 1.6
var _on_screen := true
var _skip := 0
var _acc_dt := 0.0
var _last_neck := Vector3.ZERO
var _neck_vel := Vector3.ZERO
var _neck_vel_s := Vector3.ZERO
var _rest: Dictionary = {}
var _meshes: Array[GeometryInstance3D] = []
var _bulb_meshes: Array[GeometryInstance3D] = []
# springs: Vector2(value, velocity)
var _sp_ear_l := Vector2.ZERO
var _sp_ear_r := Vector2.ZERO
var _sp_ear_spread := Vector2.ZERO
var _sp_ant_x := Vector2.ZERO
var _sp_ant_z := Vector2.ZERO
var _sp_tail := Vector2.ZERO
var _sp_scarf := Vector2.ZERO
var _sp_head := Vector2.ZERO
var _kick := 0.0             # impulse added to the springs by surprises / landings
var _ready_done := false

@onready var rig: Node3D = $Rig
@onready var hips: Node3D = $Rig/Hips
@onready var neck: Node3D = $Rig/Hips/Neck
@onready var foot_l: Node3D = $Rig/FootL
@onready var foot_r: Node3D = $Rig/FootR
@onready var arm_l: Node3D = $Rig/Hips/ArmL
@onready var arm_r: Node3D = $Rig/Hips/ArmR
@onready var ear_l: Node3D = $Rig/Hips/Neck/EarL
@onready var ear_r: Node3D = $Rig/Hips/Neck/EarR
@onready var antenna: Node3D = $Rig/Hips/Neck/Antenna
@onready var bulb: Node3D = $Rig/Hips/Neck/Antenna/Bulb
@onready var tail: Node3D = $Rig/Hips/Tail
@onready var scarf: Node3D = $Rig/Hips/Scarf
@onready var scarf_tail: Node3D = $Rig/Hips/Scarf/ScarfTail
@onready var eye_l: Node3D = $Rig/Hips/Neck/EyeL
@onready var eye_r: Node3D = $Rig/Hips/Neck/EyeR
@onready var lid_l: Node3D = $Rig/Hips/Neck/LidL
@onready var lid_r: Node3D = $Rig/Hips/Neck/LidR
@onready var happy_l: Node3D = $Rig/Hips/Neck/HappyL
@onready var happy_r: Node3D = $Rig/Hips/Neck/HappyR
@onready var mouth_smile: Node3D = $Rig/Hips/Neck/Mouth/Smile
@onready var mouth_open: Node3D = $Rig/Hips/Neck/Mouth/Open
@onready var mouth_oh: Node3D = $Rig/Hips/Neck/Mouth/Oh
@onready var emote_sprite: Sprite3D = $Emote
@onready var shadow: Node3D = $Shadow
@onready var items := {
	"hammer": $Rig/Hips/ArmR/HandR/Hammer, "wrench": $Rig/Hips/ArmR/HandR/Wrench,
	"clipboard": $Rig/Hips/ArmL/HandL/Clipboard, "crate": $Rig/Hips/Carry/Crate,
	"scanner": $Rig/Hips/ScanHold/Scanner,
}


class Pose:
	var rig_y := 0.0
	var squash := 1.0
	var lean := 0.0
	var roll := 0.0
	var hips_y := 0.0
	var hips_pitch := 0.0
	var hips_roll := 0.0
	var hips_yaw := 0.0
	var head := Vector3.ZERO      # pitch, yaw, roll
	var head_y := 0.0
	var arm_l := Vector3.ZERO     # pitch (+ back), twist, raise (+ outward/up)
	var arm_r := Vector3.ZERO
	var foot_l := Vector3.ZERO    # offset
	var foot_r := Vector3.ZERO
	var foot_pitch := Vector2.ZERO
	var ear_lift := 0.0
	var ear_spread := 0.0
	var tail_wag := 0.0
	var tail_lift := 0.0
	var eye_scale := 1.0
	var lid := 0.0
	var mouth := 0              # 0 smile, 1 open, 2 oh
	var happy := false
	var item := ""
	var bulb_pulse := 1.0

	func copy() -> Pose:
		var p := Pose.new()
		p.rig_y = rig_y; p.squash = squash; p.lean = lean; p.roll = roll
		p.hips_y = hips_y; p.hips_pitch = hips_pitch; p.hips_roll = hips_roll; p.hips_yaw = hips_yaw
		p.head = head; p.head_y = head_y; p.arm_l = arm_l; p.arm_r = arm_r
		p.foot_l = foot_l; p.foot_r = foot_r; p.foot_pitch = foot_pitch
		p.ear_lift = ear_lift; p.ear_spread = ear_spread; p.tail_wag = tail_wag; p.tail_lift = tail_lift
		p.eye_scale = eye_scale; p.lid = lid; p.mouth = mouth; p.happy = happy; p.item = item
		p.bulb_pulse = bulb_pulse
		return p

	func blend(o: Pose, w: float) -> void:
		if w <= 0.0:
			return
		rig_y = lerpf(rig_y, o.rig_y, w); squash = lerpf(squash, o.squash, w)
		lean = lerpf(lean, o.lean, w); roll = lerpf(roll, o.roll, w)
		hips_y = lerpf(hips_y, o.hips_y, w); hips_pitch = lerpf(hips_pitch, o.hips_pitch, w)
		hips_roll = lerpf(hips_roll, o.hips_roll, w); hips_yaw = lerpf(hips_yaw, o.hips_yaw, w)
		head = head.lerp(o.head, w); head_y = lerpf(head_y, o.head_y, w)
		arm_l = arm_l.lerp(o.arm_l, w); arm_r = arm_r.lerp(o.arm_r, w)
		foot_l = foot_l.lerp(o.foot_l, w); foot_r = foot_r.lerp(o.foot_r, w)
		foot_pitch = foot_pitch.lerp(o.foot_pitch, w)
		ear_lift = lerpf(ear_lift, o.ear_lift, w); ear_spread = lerpf(ear_spread, o.ear_spread, w)
		tail_wag = lerpf(tail_wag, o.tail_wag, w); tail_lift = lerpf(tail_lift, o.tail_lift, w)
		eye_scale = lerpf(eye_scale, o.eye_scale, w); lid = lerpf(lid, o.lid, w)
		bulb_pulse = lerpf(bulb_pulse, o.bulb_pulse, w)
		if w >= 0.5:
			mouth = o.mouth
			happy = o.happy
			item = o.item


# ================================================================== lifecycle
func _ready() -> void:
	_rng.seed = hash(personality_seed) if personality_seed != 0 else hash(get_instance_id())
	for n in [rig, hips, neck, foot_l, foot_r, arm_l, arm_r, ear_l, ear_r, antenna, bulb, tail, scarf_tail,
			eye_l, eye_r, lid_l, lid_r, happy_l, happy_r]:
		_rest[n] = (n as Node3D).transform
	_meshes.clear()
	for mi in find_children("*", "GeometryInstance3D", true, false):
		if mi is MeshInstance3D and mi.get_parent() != self:   # skip the blob shadow
			var g := mi as MeshInstance3D
			_meshes.append(g)
			if body_material:
				g.material_override = body_material
			g.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
			g.visibility_range_end = cull_distance
			g.visibility_range_end_margin = 4.0
			if bulb.is_ancestor_of(g):
				_bulb_meshes.append(g)
	(shadow as GeometryInstance3D).visibility_range_end = cull_distance
	emote_sprite.visibility_range_end = cull_distance
	_ready_done = true
	_apply_colors()
	_apply_role()
	_blink_next = _rng.randf_range(0.5, 3.0)
	_phase = _rng.randf() * TAU
	_t = _rng.randf() * 10.0
	if not Engine.is_editor_hint():
		play(start_action)
		var vis := get_node_or_null("OnScreen") as VisibleOnScreenNotifier3D
		if vis:
			vis.screen_entered.connect(func() -> void: _on_screen = true)
			vis.screen_exited.connect(func() -> void: _on_screen = false)
		if listen_to_events:
			NpcEvents.bus().event.connect(_on_bus_event)
	_last_neck = neck.global_position if is_inside_tree() else Vector3.ZERO
	_animate(0.0)


func _exit_tree() -> void:
	if not Engine.is_editor_hint() and NpcEvents.bus().event.is_connected(_on_bus_event):
		NpcEvents.bus().event.disconnect(_on_bus_event)


func _process(delta: float) -> void:
	if Engine.is_editor_hint() and not animate_in_editor:
		return
	if paused:
		return
	_tick_timers(delta)
	if not _on_screen and not Engine.is_editor_hint():
		return
	# distance LOD: update far creatures less often (dt accumulates, motion stays correct)
	_acc_dt += delta
	var every := 1
	var cam := get_viewport().get_camera_3d() if is_inside_tree() else null
	if cam:
		var d := cam.global_position.distance_to(global_position)
		every = 1 if d < lod_distance else (2 if d < lod_distance * 2.0 else 4)
	_skip += 1
	if _skip < every:
		return
	_skip = 0
	_animate(minf(_acc_dt, 0.1))
	_acc_dt = 0.0


## Advances the animation by dt seconds (used by screenshot tools with paused = true).
func advance(dt: float) -> void:
	_tick_timers(dt)
	_animate(dt)


# ================================================================== public API
## Velocity of the creature in world space (the NPC brain moves the parent node).
func set_move_velocity(v: Vector3) -> void:
	var s := global_basis.get_scale().x if is_inside_tree() else 1.0
	_move_local = (global_basis.orthonormalized().inverse() * v) / maxf(s, 0.01) if is_inside_tree() else v
	_speed = Vector2(_move_local.x, _move_local.z).length()


## Starts a loop action (LOOP_ACTIONS) or a one-shot (ONESHOTS) that plays over it.
func play(action: String, duration := -1.0) -> void:
	if ONESHOTS.has(action):
		_shot = action
		_shot_t = 0.0
		_shot_len = duration if duration > 0.0 else float(ONESHOTS[action])
		_on_shot_start(action)
	elif action in LOOP_ACTIONS:
		if action == _loop:
			return
		_prev_loop = _loop
		_prev_loop_w = _loop_w if _loop != "idle" else 0.0
		_loop = action
		_loop_t = 0.0
		_loop_w = 0.0
	else:
		push_warning("Cometling: unknown action '%s'" % action)


## Queues one-shots to play one after another (e.g. ["surprise", "cheer"]).
func play_sequence(actions: Array) -> void:
	_queue.clear()
	for a in actions:
		_queue.append(String(a))
	if _shot == "" and not _queue.is_empty():
		play(_queue.pop_front())


func current_action() -> String:
	return _shot if _shot != "" else _loop


func is_busy() -> bool:
	return _shot != "" or not _queue.is_empty()


func look_at_point(p: Vector3, weight := 1.0) -> void:
	look_target = p
	look_weight = weight


func clear_look() -> void:
	look_weight = 0.0


## Reaction to something happening in the hangar. Known events:
## part_placed, part_removed, vessel_cleared, launch, success, failure, hello, staged.
func react(event: String) -> void:
	match event:
		"part_placed":
			play_sequence(["surprise", ["cheer", "jump", "spin"][_rng.randi() % 3]])
			show_emote(["exclaim", "star", "sparkle"][_rng.randi() % 3])
		"part_removed":
			play_sequence(["surprise", "nod"])
			show_emote("sweat")
		"vessel_cleared":
			play_sequence(["surprise"])
			show_emote("question")
		"launch", "success":
			play_sequence(["cheer", "jump", "cheer"])
			show_emote(["rocket", "heart", "fire"][_rng.randi() % 3])
		"failure":
			play_sequence(["surprise", "nod"])
			show_emote("sweat")
		"hello":
			play_sequence(["wave"])
			show_emote("happy")
		"staged":
			play_sequence(["nod"])
			show_emote("idea")
		_:
			play_sequence(["surprise"])
			show_emote("exclaim")


func show_emote(emote: String, duration := 1.8) -> void:
	var i := EMOTES.find(emote)
	if i < 0 or emote_sprite == null:
		return
	emote_sprite.frame = i
	emote_sprite.visible = true
	_emote_t = 0.0
	_emote_len = duration


func set_colors(body: Color, spot: Color, glow := Color(0, 0, 0, 0)) -> void:
	body_color = body
	spot_color = spot
	glow_color = glow


func effective_glow() -> Color:
	return glow_color if glow_color.a > 0.0 else ROLE_GLOW.get(role, ROLE_GLOW["ground"])


# ================================================================== look & role
func _apply_colors() -> void:
	if not _ready_done:
		return
	var g := effective_glow()
	for m in _meshes:
		m.set_instance_shader_parameter("body_tint", body_color)
		m.set_instance_shader_parameter("spot_tint", spot_color)
		m.set_instance_shader_parameter("glow_tint", g)


func _apply_role() -> void:
	if not _ready_done:
		return
	var acc := {"Helmet": "pilot", "Scarf": "pilot", "HardHat": "engineer", "Belt": "engineer",
		"Goggles": "scientist", "Backpack": "scientist", "Vest": "ground"}
	for n in acc:
		var node := find_child(n, true, false) as Node3D
		if node:
			node.visible = acc[n] == role
	_apply_colors()


func _on_bus_event(event: String, data: Dictionary) -> void:
	if not is_inside_tree() or not is_visible_in_tree():
		return
	# optional radius: only creatures near data.position react
	if data.has("position") and data.has("radius"):
		var p: Vector3 = data["position"]
		if p.distance_to(global_position) > float(data["radius"]):
			return
	var delay := _rng.randf_range(0.0, float(data.get("stagger", 0.35)))
	if delay <= 0.01:
		react(event)
	else:
		get_tree().create_timer(delay).timeout.connect(func() -> void:
			if is_inside_tree():
				react(event))


# ================================================================== timers
func _tick_timers(dt: float) -> void:
	_t += dt
	_loop_t += dt
	_loop_w = minf(1.0, _loop_w + dt / 0.3)
	_prev_loop_w = maxf(0.0, _prev_loop_w - dt / 0.3)
	if _shot != "":
		_shot_t += dt
		if _shot_t >= _shot_len:
			var done := _shot
			_shot = ""
			action_finished.emit(done)
			if not _queue.is_empty():
				play(_queue.pop_front())
	# blinking (sometimes a double blink)
	if _blink_t >= 0.0:
		_blink_t += dt
		if _blink_t > 0.16:
			_blink_t = -1.0
			if _blink_double:
				_blink_double = false
				_blink_next = 0.12
	else:
		_blink_next -= dt
		if _blink_next <= 0.0:
			_blink_t = 0.0
			_blink_double = _rng.randf() < 0.25
			_blink_next = _rng.randf_range(1.6, 4.8)
	# idle glances
	_glance_next -= dt
	if _glance_next <= 0.0:
		_glance_next = _rng.randf_range(0.8, 3.2)
		_glance_target = Vector2(_rng.randf_range(-0.5, 0.5), _rng.randf_range(-0.15, 0.2)) \
			if _rng.randf() < 0.7 else Vector2.ZERO
	# emote bubble
	if _emote_t >= 0.0:
		_emote_t += dt
		if _emote_t > _emote_len:
			_emote_t = -1.0
			emote_sprite.visible = false


func _on_shot_start(action: String) -> void:
	match action:
		"surprise":
			_kick = 1.0
		"jump":
			_kick = 0.5


# ================================================================== the animation
static func _ease_out_back(x: float) -> float:
	var c1 := 1.70158
	var c3 := c1 + 1.0
	return 1.0 + c3 * pow(x - 1.0, 3) + c1 * pow(x - 1.0, 2)


static func _smooth(x: float) -> float:
	x = clampf(x, 0.0, 1.0)
	return x * x * (3.0 - 2.0 * x)


## Damped spring (value, velocity), sub-stepped so long frames (LOD updates) stay stable.
static func _spring(s: Vector2, target: float, freq: float, damp: float, dt: float) -> Vector2:
	var w := TAU * freq
	var steps := clampi(ceili(dt / 0.012), 1, 12)
	var h := dt / steps
	for i in steps:
		var acc := w * w * (target - s.x) - 2.0 * damp * w * s.y
		s.y += acc * h
		s.x += s.y * h
	if not is_finite(s.x) or not is_finite(s.y):
		return Vector2(target, 0.0)
	return Vector2(clampf(s.x, -3.0, 3.0), clampf(s.y, -60.0, 60.0))


func _animate(dt: float) -> void:
	if not _ready_done:
		return
	_speed_s = lerpf(_speed_s, _speed, 1.0 - exp(-8.0 * dt))
	var walk := clampf(_speed_s / 0.5, 0.0, 1.0)
	# stride: ~0.16 m per step in model units, but never slower than a lazy shuffle
	var cadence := maxf(_speed_s / 0.16, 2.2 if walk > 0.05 else 0.0)
	_phase = fmod(_phase + dt * cadence * PI, TAU * 64.0)

	var p := Pose.new()
	_pose_idle(p)
	if walk > 0.0:
		var wp := p.copy()
		_pose_walk(wp, walk)
		p.blend(wp, minf(1.0, walk * 2.0))
	# loop action (with a cross-fade from the previous one)
	if _prev_loop_w > 0.0 and _prev_loop != "idle":
		var pp := p.copy()
		_pose_loop(pp, _prev_loop, _loop_t + 10.0, walk)
		p.blend(pp, _smooth(_prev_loop_w))
	if _loop != "idle":
		var lp := p.copy()
		_pose_loop(lp, _loop, _loop_t, walk)
		p.blend(lp, _smooth(_loop_w))
	# one-shot on top, eased in and out
	if _shot != "":
		var sp := p.copy()
		_pose_shot(sp, _shot, _shot_t, _shot_len)
		var w := _smooth(_shot_t / 0.12) * _smooth((_shot_len - _shot_t) / 0.2)
		p.blend(sp, w)
	_apply_look(p, dt)
	_apply(p, dt)


func _pose_idle(p: Pose) -> void:
	var br := sin(_t * TAU * 0.33)
	p.squash = 1.0 + br * 0.018
	p.hips_y = br * 0.004
	p.head_y = sin(_t * TAU * 0.33 - 0.6) * 0.006
	p.head.z = sin(_t * 0.7) * 0.05
	p.head.x = sin(_t * 0.53) * 0.03
	p.hips_roll = sin(_t * 0.9) * 0.02
	p.arm_l = Vector3(sin(_t * 1.1) * 0.05, 0, 0.12 + br * 0.04)
	p.arm_r = Vector3(sin(_t * 1.1 + 1.0) * 0.05, 0, 0.12 + br * 0.04)
	p.ear_lift = 0.0
	p.tail_wag = sin(_t * 2.3) * 0.25 + sin(_t * 5.1) * 0.05
	p.bulb_pulse = 0.85 + 0.25 * (0.5 + 0.5 * sin(_t * 2.6))


func _pose_walk(p: Pose, walk: float) -> void:
	var s := sin(_phase)
	var c := cos(_phase)
	var bounce := absf(s)                       # 0 at foot contact, 1 mid-step
	var contact := 1.0 - bounce
	p.hips_y = bounce * 0.035 * (0.6 + walk * 0.6)
	p.squash = 1.0 - pow(contact, 6.0) * 0.08 + pow(bounce, 2.0) * 0.045
	p.hips_roll = c * 0.07
	p.hips_yaw = c * 0.08
	p.lean = 0.06 + walk * 0.08
	p.head = Vector3(-0.02 - bounce * 0.04, -c * 0.05, -c * 0.05)
	p.head_y = -bounce * 0.008
	var step := 0.07 * (0.5 + walk * 0.5)
	p.foot_l = Vector3(0, maxf(0.0, s) * 0.06, c * step)
	p.foot_r = Vector3(0, maxf(0.0, -s) * 0.06, -c * step)
	p.foot_pitch = Vector2(-maxf(0.0, s) * 0.5 + 0.15 * c, -maxf(0.0, -s) * 0.5 - 0.15 * c)
	p.arm_l = Vector3(c * 0.6 * walk, 0, 0.22)
	p.arm_r = Vector3(-c * 0.6 * walk, 0, 0.22)
	p.tail_wag = sin(_phase * 0.5) * 0.4
	p.tail_lift = 0.25


func _pose_loop(p: Pose, action: String, t: float, walk: float) -> void:
	match action:
		"sit":
			var br := sin(t * TAU * 0.25)
			p.rig_y = -0.13
			p.squash = 0.95 + br * 0.02
			p.foot_l = Vector3(0.03, 0.12, 0.17)
			p.foot_r = Vector3(-0.03, 0.12, 0.17)
			p.foot_pitch = Vector2(-1.25 + sin(t * 2.2) * 0.25, -1.25 + sin(t * 2.2 + 1.3) * 0.25)
			p.hips_pitch = -0.2
			p.head = Vector3(0.12 + br * 0.03, sin(t * 0.4) * 0.25, sin(t * 0.6) * 0.12)
			p.arm_l = Vector3(-0.35, 0, 0.35)
			p.arm_r = Vector3(-0.35, 0, 0.35)
			p.lid = 0.45 + 0.1 * br
			p.tail_wag = sin(t * 1.2) * 0.3
			p.tail_lift = -0.35
			p.ear_lift = -0.15
		"look_up":
			var sw := sin(t * 1.3)
			p.hips_pitch = -0.1
			p.lean = -0.06
			p.head.z = sw * 0.08
			p.arm_l = Vector3(0.35, 0, 0.18)
			p.arm_r = Vector3(0.35, 0, 0.18)
			p.mouth = 2
			p.eye_scale = 1.08
			p.ear_lift = 0.15
			p.tail_wag = sin(t * 3.0) * 0.5
		"work_hammer":
			var cyc := fmod(t, 0.8) / 0.8
			var up := _smooth(cyc / 0.62)                           # slow wind-up
			var strike := clampf((cyc - 0.62) / 0.1, 0.0, 1.0)
			strike = strike * strike * strike
			var impact := clampf(1.0 - (cyc - 0.72) / 0.28, 0.0, 1.0) if cyc > 0.72 else 0.0
			var arm := lerpf(-0.9, -2.5, up)
			arm = lerpf(arm, -0.75, strike)
			p.arm_r = Vector3(arm + impact * 0.08, 0.1, 0.1)
			p.arm_l = Vector3(-0.9, 0, 0.2)
			p.hips_pitch = 0.12 + impact * 0.05 - up * 0.04 * (1.0 - strike)
			p.squash = 1.0 - impact * impact * 0.07 + up * 0.03 * (1.0 - strike)
			p.head = Vector3(0.16 + impact * 0.08, 0.1, 0.0)
			p.mouth = 0 if impact < 0.4 else 2
			p.item = "hammer"
			p.tail_wag = sin(t * 4.0) * 0.4
			if impact > 0.95 and _rng.randf() < 0.05:
				_kick = maxf(_kick, 0.25)
		"work_scan":
			var sweep := sin(t * TAU * 0.35)
			p.arm_l = Vector3(-1.15, 0, 0.32)
			p.arm_r = Vector3(-1.15, 0, 0.32)
			p.hips_yaw = sweep * 0.35
			p.head = Vector3(0.22 + sin(t * 3.1) * 0.04, sweep * 0.25, sweep * 0.06)
			p.item = "scanner"
			p.bulb_pulse = 1.0 + 0.5 * (0.5 + 0.5 * sin(t * 9.0))
			p.mouth = 2 if fmod(t, 4.0) > 3.2 else 0
			p.tail_wag = sweep * 0.3
		"carry":
			p.arm_l = Vector3(-1.2, 0, 0.42)
			p.arm_r = Vector3(-1.2, 0, 0.42)
			p.hips_pitch = -0.08
			p.lean = 0.02
			p.squash -= 0.02
			p.head = Vector3(-0.08, p.head.y * 0.5, p.head.z)
			p.item = "crate"
			p.mouth = 0
		"clipboard":
			var w2 := sin(t * 7.0)
			p.arm_l = Vector3(-1.0, 0.2, 0.35)
			p.arm_r = Vector3(-0.85 + w2 * 0.06, 0, 0.3 + w2 * 0.04)
			p.head = Vector3(0.3, -0.1 + sin(t * 0.8) * 0.12, 0.08)
			p.item = "clipboard"
			p.mouth = 2 if fmod(t, 3.0) > 2.4 else 0
			if fmod(t, 3.0) > 2.4:
				p.head.x = 0.1
		"talk":
			var g1 := sin(t * 3.4)
			var g2 := sin(t * 2.1 + 1.0)
			p.head = Vector3(sin(t * 6.0) * 0.06, p.head.y, sin(t * 1.7) * 0.12)
			p.arm_l = Vector3(-0.5 - maxf(0.0, g1) * 0.7, 0, 0.25 + maxf(0.0, g1) * 0.3)
			p.arm_r = Vector3(-0.5 - maxf(0.0, g2) * 0.7, 0, 0.25 + maxf(0.0, g2) * 0.3)
			p.mouth = 1 if fmod(t * 5.0, 2.0) < 1.0 and fmod(t, 3.0) < 2.2 else 0
			p.squash = 1.0 + sin(t * 6.0) * 0.015
			p.tail_wag = sin(t * 4.0) * 0.4
		"dance":
			var b := sin(t * TAU * 1.0)
			var bb := absf(sin(t * TAU * 1.0))
			p.rig_y = bb * 0.03
			p.squash = 1.0 - (1.0 - bb) * 0.06
			p.hips_roll = b * 0.16
			p.roll = b * 0.05
			p.head = Vector3(-0.05, b * 0.15, -b * 0.18)
			p.arm_l = Vector3(-0.3 + b * 0.5, 0, 1.6 + b * 0.5)
			p.arm_r = Vector3(-0.3 - b * 0.5, 0, 1.6 - b * 0.5)
			p.foot_l = Vector3(0, maxf(0.0, b) * 0.05, 0)
			p.foot_r = Vector3(0, maxf(0.0, -b) * 0.05, 0)
			p.happy = true
			p.mouth = 1
			p.tail_wag = b * 0.7
	if walk > 0.3 and action in ["sit", "work_hammer", "work_scan", "clipboard", "talk", "dance"]:
		# loops that make no sense while walking keep only their upper-body parts
		p.rig_y = 0.0


func _pose_shot(p: Pose, action: String, t: float, length: float) -> void:
	var u := t / length
	match action:
		"wave":
			var osc := sin(t * 13.0)
			p.arm_r = Vector3(-0.35, 0.0, 2.05 + osc * 0.32)
			p.arm_l = Vector3(0.1, 0, 0.3)
			p.head = Vector3(-0.05, p.head.y, -0.16 + osc * 0.03)
			p.hips_roll = -0.06
			p.mouth = 1
			p.squash = 1.0 + sin(t * 6.5) * 0.02
			p.tail_wag = sin(t * 9.0) * 0.6
			p.ear_lift = 0.2
		"cheer":
			var hop := absf(sin(t * TAU * 1.6))
			p.rig_y = hop * 0.11
			p.squash = 1.0 - pow(1.0 - hop, 4.0) * 0.12 + hop * 0.05
			p.arm_l = Vector3(-0.25, 0, 1.9 + sin(t * TAU * 1.6) * 0.3)
			p.arm_r = Vector3(-0.25, 0, 1.9 - sin(t * TAU * 1.6) * 0.3)
			p.foot_l = Vector3(0, hop * 0.03, 0)
			p.foot_r = Vector3(0, hop * 0.03, 0)
			p.head = Vector3(-0.15, sin(t * 4.0) * 0.1, sin(t * 5.0) * 0.12)
			p.happy = true
			p.mouth = 1
			p.ear_lift = 0.35
			p.tail_wag = sin(t * 14.0) * 0.7
			p.bulb_pulse = 1.6
		"jump":
			var anticip := 0.2
			var air := 0.42
			if t < anticip:
				var a := _smooth(t / anticip)
				p.squash = 1.0 - a * 0.2
				p.rig_y = -a * 0.02
				p.arm_l = Vector3(0.6 * a, 0, 0.3)
				p.arm_r = Vector3(0.6 * a, 0, 0.3)
				p.head.x = 0.12 * a
				p.ear_lift = -0.2 * a
			elif t < anticip + air:
				var k := (t - anticip) / air
				p.rig_y = 4.0 * k * (1.0 - k) * 0.34
				p.squash = 1.0 + 0.16 * (1.0 - k) * (1.0 - k) - 0.04 * k
				p.arm_l = Vector3(-0.3, 0, 1.95)
				p.arm_r = Vector3(-0.3, 0, 1.95)
				p.foot_l = Vector3(0, 0.04, -0.02)
				p.foot_r = Vector3(0, 0.04, -0.02)
				p.foot_pitch = Vector2(0.4, 0.4)
				p.head.x = -0.2
				p.happy = true
				p.mouth = 1
				p.ear_lift = -0.3
			else:
				var l := (t - anticip - air) / (length - anticip - air)
				var sq := sin(clampf(l * 1.6, 0.0, 1.0) * PI)
				p.squash = 1.0 - sq * 0.18
				p.arm_l = Vector3(0.0, 0, 0.9 * (1.0 - l) + 0.15)
				p.arm_r = Vector3(0.0, 0, 0.9 * (1.0 - l) + 0.15)
				p.head.x = 0.1 * sq
				p.happy = l < 0.6
				p.mouth = 1 if l < 0.6 else 0
				if l < 0.05:
					_kick = maxf(_kick, 0.6)
		"surprise":
			var pop := _ease_out_back(clampf(t / 0.22, 0.0, 1.0))
			var settle := _smooth((t - 0.6) / 0.5)
			var hop := sin(clampf(t / 0.3, 0.0, 1.0) * PI)
			p.rig_y = hop * 0.07
			p.squash = 1.0 + hop * 0.1 - settle * 0.0
			p.arm_l = Vector3(-0.35, 0, lerpf(1.25 * pop, 0.35, settle))
			p.arm_r = Vector3(-0.35, 0, lerpf(1.25 * pop, 0.35, settle))
			p.head = Vector3(lerpf(-0.22, -0.05, settle), p.head.y, 0.0)
			p.hips_pitch = lerpf(-0.12, 0.0, settle)
			p.eye_scale = lerpf(1.3, 1.08, settle)
			p.mouth = 2
			p.ear_lift = lerpf(0.55, 0.1, settle)
			p.ear_spread = lerpf(0.3, 0.0, settle)
			p.tail_lift = 0.5
			p.bulb_pulse = 2.0 - settle
		"nod":
			var n := sin(u * TAU * 2.0) * (1.0 - u)
			p.head = Vector3(0.25 * n + 0.05, p.head.y, 0.05)
			p.squash = 1.0 - absf(n) * 0.03
			p.mouth = 0
		"spin":
			var k := _smooth(u)
			p.hips_yaw = k * TAU
			p.rig_y = sin(u * PI) * 0.12
			p.arm_l = Vector3(0, 0, 1.4 * sin(u * PI))
			p.arm_r = Vector3(0, 0, 1.4 * sin(u * PI))
			p.happy = true
			p.mouth = 1
			p.ear_lift = 0.4 * sin(u * PI)


func _apply_look(p: Pose, dt: float) -> void:
	_glance = _glance.lerp(_glance_target, 1.0 - exp(-4.0 * dt))
	var want := _glance
	if look_weight > 0.0 and is_inside_tree():
		var local := global_transform.affine_inverse() * look_target
		var from := Vector3(0, 0.66, 0)
		var d := local - from
		var yaw := atan2(d.x, d.z)
		var pitch := -atan2(d.y, Vector2(d.x, d.z).length())
		var target := Vector2(clampf(yaw, -1.2, 1.2), clampf(pitch, -0.55, 0.35))
		want = want.lerp(target, look_weight)
	_look_cur = _look_cur.lerp(want, 1.0 - exp(-6.0 * dt))
	p.head.y += _look_cur.x * 0.75
	p.hips_yaw += _look_cur.x * 0.25
	p.head.x += _look_cur.y * 0.8
	p.hips_pitch += _look_cur.y * 0.15


func _apply(p: Pose, dt: float) -> void:
	# whole-body squash & stretch from the feet
	var sq := maxf(p.squash, 0.5)
	var side := 1.0 / sqrt(sq)
	rig.transform = Transform3D(Basis.from_euler(Vector3(p.lean, 0, p.roll)).scaled(Vector3(side, sq, side)),
		Vector3(0, p.rig_y, 0))
	_pose_node(hips, Vector3(p.hips_pitch, p.hips_yaw, p.hips_roll), Vector3(0, p.hips_y, 0))
	_pose_node(neck, p.head, Vector3(0, p.head_y, 0))
	_pose_node(foot_l, Vector3(p.foot_pitch.x, 0, 0), p.foot_l)
	_pose_node(foot_r, Vector3(p.foot_pitch.y, 0, 0), p.foot_r)
	_pose_node(arm_l, Vector3(p.arm_l.x, p.arm_l.y, p.arm_l.z), Vector3.ZERO)
	_pose_node(arm_r, Vector3(p.arm_r.x, -p.arm_r.y, -p.arm_r.z), Vector3.ZERO)
	# shadow follows jumps: smaller and lighter in the air
	var air := clampf(p.rig_y / 0.35, 0.0, 1.0)
	shadow.scale = Vector3.ONE * (1.0 - air * 0.35)

	# secondary motion: springs driven by how the head moves
	if dt > 0.0:
		var np := neck.global_position
		var v := (np - _last_neck) / dt
		_last_neck = np
		var s := maxf(global_basis.get_scale().x, 0.01)
		_neck_vel = (global_basis.orthonormalized().inverse() * v) / s
		_neck_vel = _neck_vel.limit_length(4.0)
		_neck_vel_s = _neck_vel_s.lerp(_neck_vel, 1.0 - exp(-12.0 * dt))
	var vup := _neck_vel_s.y
	var vfwd := _neck_vel_s.z
	var kick := _kick
	_kick = maxf(0.0, _kick - dt * 4.0)
	var ear_t := p.ear_lift + clampf(-vup * 0.9, -0.5, 0.6) + clampf(vfwd * 0.5, 0.0, 0.5) + kick * 0.6
	_sp_ear_l = _spring(_sp_ear_l, ear_t + sin(_t * 1.9) * 0.03, 2.4, 0.22, dt)
	_sp_ear_r = _spring(_sp_ear_r, ear_t + sin(_t * 1.9 + 0.9) * 0.03, 2.2, 0.2, dt)
	_sp_ear_spread = _spring(_sp_ear_spread, p.ear_spread + kick * 0.25, 3.0, 0.25, dt)
	var el: Transform3D = _rest[ear_l]
	var er: Transform3D = _rest[ear_r]
	ear_l.transform = Transform3D(Basis.from_euler(Vector3(_sp_ear_l.x, 0, _sp_ear_spread.x - _sp_ear_l.x * 0.25)), el.origin)
	ear_r.transform = Transform3D(Basis.from_euler(Vector3(_sp_ear_r.x, 0, -_sp_ear_spread.x + _sp_ear_r.x * 0.25)), er.origin)
	_sp_ant_x = _spring(_sp_ant_x, clampf(-vfwd * 0.35 + vup * 0.4, -0.7, 0.7) - kick * 0.4, 3.2, 0.16, dt)
	_sp_ant_z = _spring(_sp_ant_z, clampf(_neck_vel_s.x * 0.4, -0.6, 0.6) + p.head.z * -0.6, 3.0, 0.16, dt)
	var ar: Transform3D = _rest[antenna]
	antenna.transform = Transform3D(Basis.from_euler(Vector3(_sp_ant_x.x, 0, _sp_ant_z.x)), ar.origin)
	var bpulse := p.bulb_pulse
	var bs := 1.0 + (bpulse - 1.0) * 0.12 + sin(_t * 5.0) * 0.03
	var br: Transform3D = _rest[bulb]
	bulb.transform = Transform3D(Basis.from_euler(Vector3(0, 0, sin(_t * 1.3) * 0.2)).scaled(Vector3.ONE * bs), br.origin)
	for m in _bulb_meshes:
		m.set_instance_shader_parameter("glow_energy", 1.1 + bpulse * 0.9)
	_sp_tail = _spring(_sp_tail, p.tail_wag, 2.8, 0.3, dt)
	var tr: Transform3D = _rest[tail]
	tail.transform = Transform3D(Basis.from_euler(Vector3(-p.tail_lift - clampf(vfwd * 0.3, 0.0, 0.4), _sp_tail.x, _sp_tail.x * 0.3)), tr.origin)
	if scarf.visible:
		_sp_scarf = _spring(_sp_scarf, clampf(vfwd * 0.9, 0.0, 1.2) + clampf(-vup * 0.6, -0.4, 0.4) + sin(_t * 3.0) * 0.08, 2.0, 0.25, dt)
		var stf: Transform3D = _rest[scarf_tail]
		scarf_tail.transform = Transform3D(Basis.from_euler(Vector3(-_sp_scarf.x, sin(_t * 2.0) * 0.2, 0)), stf.origin)

	# face: blink, wide eyes, happy eyes, lids, mouth
	var blink := 0.0
	if _blink_t >= 0.0:
		blink = sin(clampf(_blink_t / 0.16, 0.0, 1.0) * PI)
	var es := p.eye_scale
	var ey := es * (1.0 - blink * 0.92)
	var look_shift := Vector3(_look_cur.x * 0.008, -_look_cur.y * 0.008, 0)
	for pair in [[eye_l, happy_l, lid_l], [eye_r, happy_r, lid_r]]:
		var e := pair[0] as Node3D
		var h := pair[1] as Node3D
		var lid := pair[2] as Node3D
		var rest: Transform3D = _rest[e]
		e.visible = not p.happy
		h.visible = p.happy
		e.transform = Transform3D(Basis.from_scale(Vector3(es, maxf(ey, 0.05), 1.0)), rest.origin + look_shift)
		var lrest: Transform3D = _rest[lid]
		var lid_amt := clampf(p.lid, 0.0, 1.0)
		lid.visible = lid_amt > 0.03 and not p.happy
		lid.transform = Transform3D(Basis.from_scale(Vector3(1.0, maxf(lid_amt, 0.01), 1.0)), lrest.origin)
	mouth_smile.visible = p.mouth == 0
	mouth_open.visible = p.mouth == 1
	mouth_oh.visible = p.mouth == 2
	for k in items:
		(items[k] as Node3D).visible = (k == p.item)

	# emote bubble: pop in with overshoot, float, shrink away
	if _emote_t >= 0.0:
		var a := clampf(_emote_t / 0.28, 0.0, 1.0)
		var out := clampf((_emote_len - _emote_t) / 0.2, 0.0, 1.0)
		var sc := _ease_out_back(a) * _smooth(out)
		emote_sprite.scale = Vector3.ONE * maxf(sc, 0.01)
		emote_sprite.position = Vector3(0, 1.32 + p.rig_y + _emote_t * 0.05 + sin(_t * 4.0) * 0.015, 0)


func _pose_node(n: Node3D, euler: Vector3, offset: Vector3) -> void:
	var r: Transform3D = _rest[n]
	n.transform = Transform3D(Basis.from_euler(euler), r.origin + offset)

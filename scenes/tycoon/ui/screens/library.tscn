[ext_resource type="Texture2D" path="res://ui/cometworks/icons/book.svg" id="2_book"]
[ext_resource type="PackedScene" path="res://scenes/tycoon/ui/tutorial/halley_portrait.tscn" id="3_portrait"]
[ext_resource type="Texture2D" path="res://ui/cometworks/icons/hq.svg" id="4_icon"]
[ext_resource type="Script" path="res://src/tycoon/ui/motion/cw_button_motion.gd" id="cwm_btn"]

[gd_scene format=3]

[ext_resource type="Script" path="res://src/menu/demo_panel.gd" id="1_demo"]
[ext_resource type="Theme" path="res://ui/menu/menu_theme.tres" id="2_theme"]
[ext_resource type="Texture2D" path="res://ui/cometworks/icons/play.svg" id="3_icon"]
[ext_resource type="PackedScene" path="res://scenes/menu/menu_item.tscn" id="4_item"]
[ext_resource type="Script" path="res://src/tycoon/ui/motion/cw_stagger.gd" id="cwm_stagger"]

[node name="DemoPanel" type="PanelContainer"]
custom_minimum_size = Vector2(500, 0)
offset_right = 500.0
offset_bottom = 300.0
theme = ExtResource("2_theme")
theme_type_variation = &"CwPanel"
script = ExtResource("1_demo")

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 2
theme_override_constants/margin_left = 8
theme_override_constants/margin_top = 6
theme_override_constants/margin_right = 8
theme_override_constants/margin_bottom = 6

[node name="VBox" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="Head" type="HBoxContainer" parent="Margin/VBox"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="Icon" type="TextureRect" parent="Margin/VBox/Head"]
custom_minimum_size = Vector2(30, 30)
layout_mode = 2
size_flags_vertical = 4
texture = ExtResource("3_icon")
expand_mode = 1
stretch_mode = 5

[node name="Title" type="Label" parent="Margin/VBox/Head"]
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"CwTitle"
theme_override_font_sizes/font_size = 24
text = "MENU_DEMO_TITLE"

[node name="Lead" type="Label" parent="Margin/VBox"]
custom_minimum_size = Vector2(460, 0)
layout_mode = 2
theme_override_colors/font_color = Color(0.3647, 0.3569, 0.549, 1)
theme_override_font_sizes/font_size = 15
text = "MENU_DEMO_LEAD"
autowrap_mode = 3

[node name="Sep" type="HSeparator" parent="Margin/VBox"]
layout_mode = 2

[node name="List" type="VBoxContainer" parent="Margin/VBox"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 4

[node name="Template" parent="Margin/VBox/List" instance=ExtResource("4_item")]
unique_name_in_owner = true
visible = false
custom_minimum_size = Vector2(0, 50)
layout_mode = 2
text = "MENU_DEMO_FAIR"
index_text = "01"
hint_key = "MENU_DEMO_DETAIL"

[node name="Empty" type="Label" parent="Margin/VBox/List"]
unique_name_in_owner = true
visible = false
layout_mode = 2
theme_override_colors/font_color = Color(0.3647, 0.3569, 0.549, 1)
theme_override_font_sizes/font_size = 15
text = "MENU_DEMO_EMPTY"
autowrap_mode = 3

[node name="Foot" type="HBoxContainer" parent="Margin/VBox"]
layout_mode = 2

[node name="Back" type="Button" parent="Margin/VBox/Foot"]
unique_name_in_owner = true
custom_minimum_size = Vector2(120, 0)
layout_mode = 2
theme_type_variation = &"CwMenuKey"
text = "MENU_OPT_BACK"

[node name="Spacer" type="Control" parent="Margin/VBox/Foot"]
layout_mode = 2
size_flags_horizontal = 3

[node name="CwCascade" type="Node" parent="."]
script = ExtResource("cwm_stagger")
target = NodePath("../Margin/VBox/List")
on_visible = true

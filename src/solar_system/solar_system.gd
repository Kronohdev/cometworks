class_name SolarSystem
extends Node3D
## Solar-system map controller (MARGIN part 2). Every visual lives in
## scenes/solar_system/solar_system.tscn (generated by tools/build_solar_system_scene.py,
## editable by hand); this script only drives time, focus, labels and the HUD text.
##
## COMPRESSED SCALE (scene units; real numbers in data/solar_system.json, formulas in
## tools/planet_gen.py and docs/solar_system.md):
##   body radius     r = 0.04 * sqrt(R_km)            Earth 3.19, Jupiter 10.58, Moon 1.67
##   Sun radius      r = 18 (clamped; the same law would give 33)
##   planet orbit    d = 36 + 72 * sqrt(a_AU)         Mercury 80.8, Earth 108, Neptune 431.5
##   moon orbit      d = r_parent * (1.4 + 0.15 * sqrt(a_km / R_parent_km))   Moon 8.2, Europa 19.7
##   time            1 real second = time_scale simulated days (HUD slider, 0.01 .. 1000)
## Orbits are circular, phased by the JPL mean longitude at J2000, so on load the planets
## sit at (approximately) their real heliocentric longitudes for today's date.
##
## LOD (GeometryInstance3D visibility ranges, set in the scene, camera distance in r units):
##   lod0 < 14 r < lod1 < 46 r < lod2   (12% fade margins). Moons are culled past 700 u,
##   moon labels/orbit lines past 120-180 u; every label hides closer than 3.2 r.

signal body_selected(body_id: String)

const DATA_PATH := "res://data/solar_system.json"
const J2000_UNIX := 946728000.0  # 2000-01-01 12:00 UTC
const FOCUS_KEYS := ["sun", "mercury", "venus", "earth", "mars", "jupiter", "saturn", "uranus", "neptune", "pluto"]
const VIEW_RADII := {"sun": 4.2, "saturn": 7.5, "jupiter": 5.0}  # framing distance in radii

## Simulated days per real second.
@export var time_scale := 8.0
@export var paused := false
## Start at the real current date (else at start_days after J2000).
@export var start_at_today := true
@export var start_days := 9797.0
@export var overview_distance := 560.0
@export_range(-89, 89, 0.1, "radians_as_degrees") var overview_pitch := deg_to_rad(26.0)
@export_range(-180, 180, 0.1, "radians_as_degrees") var overview_yaw := deg_to_rad(-32.0)

var sim_days := 0.0
var bodies := {}  # id -> SolarBody
var info := {}    # id -> Dictionary (data/solar_system.json)
var selected := ""

var _date_timer := 0.0

@onready var cam: SpaceCamera = $CameraRig
@onready var _slider: HSlider = %TimeSlider
@onready var _rate: Label = %RateLabel
@onready var _date: Label = %DateLabel
@onready var _pause: Button = %BtnPause


func _ready() -> void:
	_ensure_translations()
	var lang := OS.get_locale_language()
	TranslationServer.set_locale("pt" if lang == "pt" else "en")
	_load_data()
	for n in find_children("*", "SolarBody", true, false):
		var b := n as SolarBody
		bodies[b.body_id] = b
	sim_days = (Time.get_unix_time_from_system() - J2000_UNIX) / 86400.0 if start_at_today else start_days
	for b: SolarBody in bodies.values():
		b.reset_to_days(sim_days)
	for btn in find_children("Btn", "Button", true, false):
		if btn.has_meta("body_id"):
			(btn as Button).pressed.connect(focus_body.bind(String(btn.get_meta("body_id"))))
	_set_time_scale(time_scale)
	_slider.set_value_no_signal(_slider_from_scale(time_scale))
	cam.focus_changed.connect(_on_focus_changed)
	overview(true)
	show_info("earth")
	refresh_texts()


func _process(delta: float) -> void:
	if not paused:
		sim_days += time_scale * delta
	_date_timer -= delta
	if _date_timer <= 0.0:
		_date_timer = 0.25
		_date.text = date_string(sim_days)


# ------------------------------------------------------------------ time
func _set_time_scale(ts: float) -> void:
	time_scale = ts
	for b: SolarBody in bodies.values():
		b.time_scale = 0.0 if paused else ts
	_rate.text = tr("SS_TIME_RATE") % rate_string(ts)


static func _scale_from_slider(v: float) -> float:
	return pow(10.0, -2.0 + 5.0 * v / 100.0)


static func _slider_from_scale(ts: float) -> float:
	return (log(ts) / log(10.0) + 2.0) / 5.0 * 100.0


func _on_time_slider_changed(v: float) -> void:
	_set_time_scale(_scale_from_slider(v))


func _on_pause_toggled(on: bool) -> void:
	paused = on
	_pause.text = "SS_PLAY" if on else "SS_PAUSE"
	_set_time_scale(time_scale)


# ------------------------------------------------------------------ focus
func focus_body(id: String) -> void:
	var b: SolarBody = bodies.get(id)
	if b == null:
		return
	var anchor := b.get_node("Pivot/Anchor") as Node3D
	cam.focus_on(anchor, b.visual_radius, b.visual_radius * VIEW_RADII.get(id, 6.0))
	show_info(id)
	body_selected.emit(id)


func overview(instant := false) -> void:
	if instant:
		cam.snap_to(Vector3.ZERO, overview_yaw, overview_pitch, overview_distance)
	else:
		cam.free_focus(Vector3.ZERO, overview_distance)
		cam.target_pitch = overview_pitch


func _on_focus_changed(_t: Node3D) -> void:
	pass


## Body under a screen position (projected discs, generous for tiny far bodies).
func pick(screen_pos: Vector2) -> String:
	var c := cam.camera
	var best := ""
	var best_score := INF
	for b: SolarBody in bodies.values():
		var p := b.body_position()
		if c.is_position_behind(p):
			continue
		var sp := c.unproject_position(p)
		var edge := c.unproject_position(p + c.global_transform.basis.x * b.visual_radius)
		var rad := maxf(sp.distance_to(edge), 14.0)
		var d := sp.distance_to(screen_pos)
		if d <= rad * 1.15 and d / rad < best_score:
			best_score = d / rad
			best = b.body_id
	return best


func _unhandled_input(event: InputEvent) -> void:
	if event is InputEventMouseButton:
		var mb := event as InputEventMouseButton
		if mb.pressed and mb.double_click and mb.button_index == MOUSE_BUTTON_LEFT:
			var id := pick(mb.position)
			if id != "":
				focus_body(id)
	elif event is InputEventKey and (event as InputEventKey).pressed and not (event as InputEventKey).echo:
		var k := (event as InputEventKey).keycode
		if k >= KEY_0 and k <= KEY_9:
			focus_body(FOCUS_KEYS[k - KEY_0])
		elif k == KEY_SPACE:
			_pause.button_pressed = not _pause.button_pressed
		elif k == KEY_F or k == KEY_HOME:
			overview()


# ------------------------------------------------------------------ text / i18n
func toggle_language() -> void:
	TranslationServer.set_locale("en" if TranslationServer.get_locale().begins_with("pt") else "pt")
	refresh_texts()


func refresh_texts() -> void:
	for b: SolarBody in bodies.values():
		var l := b.label()
		if l:
			l.text = tr(b.name_key)
	_rate.text = tr("SS_TIME_RATE") % rate_string(time_scale)
	_date.text = date_string(sim_days)
	if selected != "":
		show_info(selected)


func show_info(id: String) -> void:
	if not info.has(id):
		return
	selected = id
	var d: Dictionary = info[id]
	var up := id.to_upper()
	(%Icon as TextureRect).texture = load("res://assets/voxel/planets/icons/%s.png" % id)
	(%BodyName as Label).text = tr("SS_NAME_" + up)
	(%BodyKind as Label).text = tr("SS_KIND_" + up)
	var r_km: float = d["radius_km"]
	(%VRadius as Label).text = tr("SS_FMT_KM") % num(r_km, 0 if r_km >= 100.0 else 1)
	var dist := ""
	if d.has("semi_major_axis_km"):
		var parent: String = d["parent"]
		dist = tr("SS_FMT_KM_FROM") % [num(float(d["semi_major_axis_km"]), 0), tr("SS_NAME_" + parent.to_upper())]
	elif float(d.get("semi_major_axis_au", 0.0)) > 0.0:
		var au: float = d["semi_major_axis_au"]
		dist = tr("SS_FMT_AU") % [num(au, 3), num(au * 149.5978707, 1)]
	else:
		dist = tr("SS_CENTER")
	(%VDistance as Label).text = dist
	var per: float = d.get("orbital_period_days", 0.0)
	if per <= 0.0:
		(%VPeriod as Label).text = "-"
	elif per > 730.0:
		(%VPeriod as Label).text = tr("SS_FMT_YEARS") % num(per / 365.256, 2)
	else:
		(%VPeriod as Label).text = tr("SS_FMT_DAYS") % num(per, 2 if per < 100.0 else 1)
	var rot: float = d["rotation_period_hours"]
	var tilt: float = d["axial_tilt_deg"]
	var rot_s := tr("SS_FMT_HOURS") % num(absf(rot), 2) if absf(rot) < 72.0 else tr("SS_FMT_DAYS") % num(absf(rot) / 24.0, 1)
	if rot < 0.0 or tilt > 90.0:
		rot_s += " · " + tr("SS_RETROGRADE")
	if d.get("tidally_locked", false):
		rot_s += " · " + tr("SS_LOCKED")
	(%VDay as Label).text = rot_s
	(%VTilt as Label).text = tr("SS_FMT_DEG") % num(tilt, 2)
	var g: float = d["surface_gravity_ms2"]
	(%VGravity as Label).text = tr("SS_FMT_G") % [num(g, 2), num(g / 9.80665, 2)]
	(%Desc as Label).text = tr("SS_DESC_" + up)


## Locale-aware number: 149,597.9 (en) / 149.597,9 (pt).
func num(x: float, decimals := 0) -> String:
	var pt := TranslationServer.get_locale().begins_with("pt")
	var txt := ("%." + str(decimals) + "f") % absf(x)
	var parts := txt.split(".")
	var ip: String = parts[0]
	var grouped := ""
	while ip.length() > 3:
		grouped = (("." if pt else ",") + ip.substr(ip.length() - 3)) + grouped
		ip = ip.substr(0, ip.length() - 3)
	grouped = ip + grouped
	if parts.size() > 1:
		grouped += ("," if pt else ".") + parts[1]
	return ("-" if x < 0.0 else "") + grouped


func rate_string(ts: float) -> String:
	if ts < 1.0:
		return tr("SS_UNIT_HOURS") % num(ts * 24.0, 1 if ts * 24.0 < 10.0 else 0)
	if ts >= 365.0:
		return tr("SS_UNIT_YEARS") % num(ts / 365.256, 1)
	return tr("SS_UNIT_DAYS") % num(ts, 1 if ts < 10.0 else 0)


func date_string(days: float) -> String:
	var dt := Time.get_datetime_dict_from_unix_time(int(J2000_UNIX + days * 86400.0))
	if TranslationServer.get_locale().begins_with("pt"):
		return "%02d/%02d/%04d" % [dt["day"], dt["month"], dt["year"]]
	return "%04d-%02d-%02d" % [dt["year"], dt["month"], dt["day"]]


func _load_data() -> void:
	var f := FileAccess.open(DATA_PATH, FileAccess.READ)
	if f == null:
		push_error("SolarSystem: cannot read " + DATA_PATH)
		return
	var parsed: Variant = JSON.parse_string(f.get_as_text())
	if parsed is Dictionary:
		for b: Dictionary in (parsed as Dictionary)["bodies"]:
			info[String(b["id"])] = b


## The CSV is registered in project.godot by the project owner; until then (or when a test
## runs with --script) load the imported .translation files directly.
static var _translations_checked := false


static func _ensure_translations() -> void:
	if _translations_checked:
		return
	_translations_checked = true
	var registered: PackedStringArray = ProjectSettings.get_setting("internationalization/locale/translations", PackedStringArray())
	for loc in ["en", "pt"]:
		var path := "res://i18n/solar_system_strings.%s.translation" % loc
		if path in registered or not ResourceLoader.exists(path):
			continue
		TranslationServer.add_translation(load(path) as Translation)

class_name MarginPalette
extends RefCounted
## MARGIN palette 2.0 (generated by tools/make_ui_kit.py: edit PALETTE there).
## Rules and swatches: docs/art/palette.md. MARK_* are reserved for the KSP-style
## CoM / CoT / CoL markers and their legend; nothing else may use them.

# palette tokens
## deepest background; text on accent fills
const INK := Color(0.0392, 0.0549, 0.0745)  # #0a0e13
## inset wells: inputs, tracks, tool groups
const WELL := Color(0.0549, 0.0784, 0.1059)  # #0e141b
## panel / sheet body (surface)
const PANEL := Color(0.0706, 0.0980, 0.1333)  # #121922
## panel gradient top, top-bar
const PANEL_HI := Color(0.0941, 0.1294, 0.1725)  # #18212c
## raised surface: cards, buttons
const RAISED := Color(0.1098, 0.1490, 0.2000)  # #1c2633
## hovered raised surface
const RAISED_HI := Color(0.1490, 0.2000, 0.2706)  # #263345
## 1 px strokes, separators, inactive outlines
const LINE := Color(0.1686, 0.2235, 0.2863)  # #2b3949
## strong strokes, hovered outlines
const LINE_HI := Color(0.2627, 0.3373, 0.4392)  # #435670
## primary text, icons
const TEXT := Color(0.9294, 0.9490, 0.9686)  # #edf2f7
## secondary text, captions
const TEXT_DIM := Color(0.5765, 0.6392, 0.7216)  # #93a3b8
## disabled, placeholders, off toggles
const TEXT_MUTED := Color(0.3725, 0.4353, 0.5176)  # #5f6f84
## Signal Orange: brand, selection, primary action
const ACCENT := Color(1.0000, 0.6039, 0.2392)  # #ff9a3d
## Signal Orange lifted: hover, text on dark tint
const ACCENT_HI := Color(1.0000, 0.7412, 0.4784)  # #ffbd7a
## Signal Orange deep: pressed primary, strokes
const ACCENT_LO := Color(0.7843, 0.4000, 0.1020)  # #c8661a
## Mission Blue: info, focus, progress, section labels
const ACCENT_2 := Color(0.4157, 0.6627, 1.0000)  # #6aa9ff
## Mission Blue lifted
const ACCENT_2_HI := Color(0.6392, 0.7882, 1.0000)  # #a3c9ff
## go / OK / good TWR
const SUCCESS := Color(0.3569, 0.8392, 0.5569)  # #5bd68e
## caution, marginal values
const WARNING := Color(1.0000, 0.7725, 0.2784)  # #ffc547
## no-go, errors, red beacons
const DANGER := Color(1.0000, 0.3725, 0.4275)  # #ff5f6d
## series 1 (blue)
const DATA_1 := Color(0.4157, 0.6627, 1.0000)  # #6aa9ff
## series 2 (orange)
const DATA_2 := Color(1.0000, 0.6039, 0.2392)  # #ff9a3d
## series 3 (teal)
const DATA_3 := Color(0.3098, 0.8392, 0.6902)  # #4fd6b0
## series 4 (violet)
const DATA_4 := Color(0.7098, 0.5647, 1.0000)  # #b590ff
## series 5 (rose)
const DATA_5 := Color(0.9569, 0.4980, 0.6431)  # #f47fa4
## series 6 (lime)
const DATA_6 := Color(0.7882, 0.8275, 0.4157)  # #c9d36a
## VAB White: walls, ceiling, enclosures
const STRUCTURE := Color(0.8745, 0.8902, 0.9059)  # #dfe3e7
## Light steel: columns, trusses, towers, rails
const METAL := Color(0.6392, 0.6784, 0.7216)  # #a3adb8
## Gunmetal: grating, pad base, machinery
const GUNMETAL := Color(0.2353, 0.2667, 0.3137)  # #3c4450
## Safety yellow: crane, handrails, edges, floor lanes
const HAZARD := Color(0.9490, 0.7176, 0.0196)  # #f2b705
## Cleanroom light: emissive panels, windows, glass
const GLASS := Color(0.7490, 0.9137, 1.0000)  # #bfe9ff

# reserved marker colours
## Center of Mass (yellow)
const MARK_COM := Color(1.0000, 0.8510, 0.1020)  # #ffd91a
## Center of Thrust (magenta)
const MARK_COT := Color(0.9490, 0.2000, 0.8510)  # #f233d9
## Center of Lift (cyan)
const MARK_COL := Color(0.2000, 0.7490, 1.0000)  # #33bfff

# light colours
## 3500 K high-bay lamps, work lights
const LAMP_WARM := Color(1.0000, 0.8863, 0.7490)  # #ffe2bf
## 6000 K fill, wall wash
const LAMP_COOL := Color(0.8941, 0.9373, 1.0000)  # #e4efff
## daylight sun through the door
const SUN := Color(1.0000, 0.9451, 0.8627)  # #fff1dc

## Data series in order (stage colours, chart series).
const DATA: Array[Color] = [DATA_1, DATA_2, DATA_3, DATA_4, DATA_5, DATA_6]

## Token name -> Color, in display order (for tooling / debug swatches).
const ALL := {
	"INK": INK,
	"WELL": WELL,
	"PANEL": PANEL,
	"PANEL_HI": PANEL_HI,
	"RAISED": RAISED,
	"RAISED_HI": RAISED_HI,
	"LINE": LINE,
	"LINE_HI": LINE_HI,
	"TEXT": TEXT,
	"TEXT_DIM": TEXT_DIM,
	"TEXT_MUTED": TEXT_MUTED,
	"ACCENT": ACCENT,
	"ACCENT_HI": ACCENT_HI,
	"ACCENT_LO": ACCENT_LO,
	"ACCENT_2": ACCENT_2,
	"ACCENT_2_HI": ACCENT_2_HI,
	"SUCCESS": SUCCESS,
	"WARNING": WARNING,
	"DANGER": DANGER,
	"DATA_1": DATA_1,
	"DATA_2": DATA_2,
	"DATA_3": DATA_3,
	"DATA_4": DATA_4,
	"DATA_5": DATA_5,
	"DATA_6": DATA_6,
	"STRUCTURE": STRUCTURE,
	"METAL": METAL,
	"GUNMETAL": GUNMETAL,
	"HAZARD": HAZARD,
	"GLASS": GLASS,
	"MARK_COM": MARK_COM,
	"MARK_COT": MARK_COT,
	"MARK_COL": MARK_COL,
	"LAMP_WARM": LAMP_WARM,
	"LAMP_COOL": LAMP_COOL,
	"SUN": SUN,
}


## Series colour for index i (wraps).
static func data(i: int) -> Color:
	return DATA[posmod(i, DATA.size())]

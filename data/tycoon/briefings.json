  },
  "discovery": {
    "_doc": "Hidden ideals and how the agency learns them. grade = development grade * (1 - w + w * fit), w = fit_weight_era[era] (forgiving early, demanding later); fit = weighted mean of the components (objective only counts for briefings). A great combo (compat great, instruments, lever match and fit all high) multiplies the grade and adds hype. The ideal balance of a mission type shows in the journal after reveal_ratio_after launches of it (or a tech, payload.json reveal_by_tech); lever ranges come from that balance.",
    "reveal_ratio_after": 2,
    "fit_weight_era": [0.2, 0.35, 0.5, 0.6, 0.65],
    "weights": {"instrument": 0.35, "power": 0.2, "data": 0.15, "team": 0.15, "objective": 0.15},
    "great": {"instrument": 0.75, "match": 0.85, "fit": 0.8, "grade_mult": 1.15, "hype": 6.0},
    "instrument": {"useless": 0.12, "bad": 0.25, "missing": 0.3},
    "power": {"night_fail": 0.45, "cold_fail": 0.35, "day_short": 0.5},
    "data": {"buffer": 1.4, "floor": 0.2},
    "team": {"bar_min": 0.25, "ops_per_member": 6.0, "ops_base": 2.0, "overload": 0.75, "small": 0.85},
    "objective": {"miss": 0.25},
    "lever_gap": 0.08,
    "lever_step": 5,
    "lever_slack": 0.02,
    "feedback_max": 5,
    "notes_keep": 30,
    "hint": {"curiosity": 0.6, "skill": 0.6, "level": 3},
    "ops": {"night_fail_weeks": 0.35, "cold_health": 0.6, "value_floor": 0.6, "value_span": 0.6, "data_min": 0.3, "data_max": 2.0}

class Pose:
	var rig_y := 0.0
	var rig_z := 0.0
	var squash := 1.0
	var lean := 0.0
	var roll := 0.0
	var hips_x := 0.0
	var hips_y := 0.0
	var hips_pitch := 0.0
	var hips_roll := 0.0
	var hips_yaw := 0.0
	var head := Vector3.ZERO      # pitch (+ down), yaw (+ left), roll
	var head_y := 0.0
	var arm_l := Vector3.ZERO     # pitch (+ back), twist, raise (+ outward/up)
	var arm_r := Vector3.ZERO
	var foot_l := Vector3.ZERO    # offset
	var foot_r := Vector3.ZERO
	var foot_pitch := Vector2.ZERO
	var ear_lift := 0.0
	var ear_spread := 0.0
	var tail_wag := 0.0
	var tail_lift := 0.0
	var eye_scale := 1.0
	var eye_squash := 1.0         # vertical only: < 1 squints (content, effort)
	var eye_close := 0.0          # 0 open .. 1 shut (sleep, yawn)
	var eye_off := Vector2.ZERO   # where the eyes look on the face (-1..1)
	var lid := 0.0
	var lid_tilt := 0.0           # + sad (outer corners down), - grumpy
	var mouth := 0                # 0 smile, 1 open, 2 oh, 3 frown
	var mouth_size := 1.0
	var happy := false
	var item := ""
	var bulb_pulse := 1.0

	func reset() -> void:
		rig_y = 0.0; rig_z = 0.0; squash = 1.0; lean = 0.0; roll = 0.0
		hips_x = 0.0; hips_y = 0.0; hips_pitch = 0.0; hips_roll = 0.0; hips_yaw = 0.0
		head = Vector3.ZERO; head_y = 0.0; arm_l = Vector3.ZERO; arm_r = Vector3.ZERO
		foot_l = Vector3.ZERO; foot_r = Vector3.ZERO; foot_pitch = Vector2.ZERO
		ear_lift = 0.0; ear_spread = 0.0; tail_wag = 0.0; tail_lift = 0.0
		eye_scale = 1.0; eye_squash = 1.0; eye_close = 0.0; eye_off = Vector2.ZERO
		lid = 0.0; lid_tilt = 0.0; mouth = 0; mouth_size = 1.0; happy = false; item = ""
		bulb_pulse = 1.0

	func copy_from(o: Pose) -> void:
		rig_y = o.rig_y; rig_z = o.rig_z; squash = o.squash; lean = o.lean; roll = o.roll
		hips_x = o.hips_x; hips_y = o.hips_y; hips_pitch = o.hips_pitch; hips_roll = o.hips_roll
		hips_yaw = o.hips_yaw
		head = o.head; head_y = o.head_y; arm_l = o.arm_l; arm_r = o.arm_r
		foot_l = o.foot_l; foot_r = o.foot_r; foot_pitch = o.foot_pitch
		ear_lift = o.ear_lift; ear_spread = o.ear_spread; tail_wag = o.tail_wag; tail_lift = o.tail_lift
		eye_scale = o.eye_scale; eye_squash = o.eye_squash; eye_close = o.eye_close; eye_off = o.eye_off
		lid = o.lid; lid_tilt = o.lid_tilt; mouth = o.mouth; mouth_size = o.mouth_size
		happy = o.happy; item = o.item; bulb_pulse = o.bulb_pulse

	func copy() -> Pose:
		var p := Pose.new()
		p.copy_from(self)
		return p

	func blend(o: Pose, w: float) -> void:
		if w <= 0.0:
			return
		rig_y = lerpf(rig_y, o.rig_y, w); rig_z = lerpf(rig_z, o.rig_z, w)
		squash = lerpf(squash, o.squash, w)
		lean = lerpf(lean, o.lean, w); roll = lerpf(roll, o.roll, w)
		hips_x = lerpf(hips_x, o.hips_x, w)
		hips_y = lerpf(hips_y, o.hips_y, w); hips_pitch = lerpf(hips_pitch, o.hips_pitch, w)
		hips_roll = lerpf(hips_roll, o.hips_roll, w); hips_yaw = lerpf(hips_yaw, o.hips_yaw, w)
		head = head.lerp(o.head, w); head_y = lerpf(head_y, o.head_y, w)
		arm_l = arm_l.lerp(o.arm_l, w); arm_r = arm_r.lerp(o.arm_r, w)
		foot_l = foot_l.lerp(o.foot_l, w); foot_r = foot_r.lerp(o.foot_r, w)
		foot_pitch = foot_pitch.lerp(o.foot_pitch, w)
		ear_lift = lerpf(ear_lift, o.ear_lift, w); ear_spread = lerpf(ear_spread, o.ear_spread, w)
		tail_wag = lerpf(tail_wag, o.tail_wag, w); tail_lift = lerpf(tail_lift, o.tail_lift, w)
		eye_scale = lerpf(eye_scale, o.eye_scale, w); lid = lerpf(lid, o.lid, w)
		eye_squash = lerpf(eye_squash, o.eye_squash, w); eye_close = lerpf(eye_close, o.eye_close, w)
		eye_off = eye_off.lerp(o.eye_off, w); lid_tilt = lerpf(lid_tilt, o.lid_tilt, w)
		mouth_size = lerpf(mouth_size, o.mouth_size, w)
		bulb_pulse = lerpf(bulb_pulse, o.bulb_pulse, w)
		if w >= 0.5:
			mouth = o.mouth
			happy = o.happy
			item = o.item


# ================================================================== lifecycle
func _ready() -> void:
	_rng.seed = hash(personality_seed) if personality_seed != 0 else hash(get_instance_id())
	for n in [rig, hips, neck, foot_l, foot_r, arm_l, arm_r, ear_l, ear_r, antenna, bulb, tail, scarf_tail,
			eye_l, eye_r, lid_l, lid_r, happy_l, happy_r, mouth, mouth_smile]:
		_rest[n] = (n as Node3D).transform
	_meshes.clear()
	for mi in find_children("*", "GeometryInstance3D", true, false):
		if mi is MeshInstance3D and mi.get_parent() != self:   # skip the blob shadow
			var g := mi as MeshInstance3D
			_meshes.append(g)
			if body_material:
				g.material_override = body_material
			g.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
			g.visibility_range_end = cull_distance
			g.visibility_range_end_margin = 4.0
			if bulb.is_ancestor_of(g):
				_bulb_meshes.append(g)
	(shadow as GeometryInstance3D).visibility_range_end = cull_distance
	emote_sprite.visibility_range_end = cull_distance
	_ready_done = true
	_apply_colors()
	_apply_role()
	_blink_next = _rng.randf_range(0.5, 3.0)
	_phase = _rng.randf() * TAU
	_t = _rng.randf() * 10.0
	_breath = _rng.randf() * TAU
	# personality: every Cometling keeps its own tempo and habits
	_energy = _rng.randf_range(0.75, 1.3)
	_tempo = _rng.randf_range(0.85, 1.18)
	_curious = _rng.randf_range(0.6, 1.5)
	_sleepy = _rng.randf_range(0.4, 1.6)
	_fid_next = _rng.randf_range(0.8, 4.0)
	_fid_w.resize(_FIDGETS.size())
	_shift_target = 1.0 if _rng.randf() < 0.5 else -1.0
	if not Engine.is_editor_hint():
		play(start_action)
		var vis := get_node_or_null("OnScreen") as VisibleOnScreenNotifier3D
		if vis:
			vis.screen_entered.connect(func() -> void: _on_screen = true)
			vis.screen_exited.connect(func() -> void: _on_screen = false)
		if listen_to_events:
			NpcEvents.bus().event.connect(_on_bus_event)
	_last_neck = neck.global_position if is_inside_tree() else Vector3.ZERO
	_last_yaw = _yaw_now()
	_animate(0.0)


func _exit_tree() -> void:
	if not Engine.is_editor_hint() and NpcEvents.bus().event.is_connected(_on_bus_event):
		NpcEvents.bus().event.disconnect(_on_bus_event)


func _process(delta: float) -> void:
	if Engine.is_editor_hint() and not animate_in_editor:
		return
	if paused:
		return
	_tick_timers(delta)
	if not _on_screen and not Engine.is_editor_hint():
		return
	# distance LOD: update far creatures less often (dt accumulates, motion stays correct)
	_acc_dt += delta
	var every := 1
	var cam := get_viewport().get_camera_3d() if is_inside_tree() else null
	if cam:
		var d := cam.global_position.distance_to(global_position)
		every = 1 if d < lod_distance else (2 if d < lod_distance * 2.0 else 4)
		var near_d := detail_distance * maxf(global_basis.get_scale().x, 0.01)
		_near = d < near_d
		_habits_ok = d < near_d * habit_distance_factor
	_skip += 1
	if _skip < every:
		return
	_skip = 0
	_animate(minf(_acc_dt, 0.1))
	_acc_dt = 0.0


## Advances the animation by dt seconds (used by screenshot tools with paused = true).
func advance(dt: float) -> void:
	_tick_timers(dt)
	_animate(dt)


# ================================================================== public API
## Velocity of the creature in world space (the NPC brain moves the parent node).
func set_move_velocity(v: Vector3) -> void:
	var s := global_basis.get_scale().x if is_inside_tree() else 1.0
	_move_local = (global_basis.orthonormalized().inverse() * v) / maxf(s, 0.01) if is_inside_tree() else v
	_speed = Vector2(_move_local.x, _move_local.z).length()


## Starts a loop action (LOOP_ACTIONS) or a one-shot (ONESHOTS) that plays over it.
## duration only applies to one-shots (e.g. play("clap", 6.0) for a long applause).
func play(action: String, duration := -1.0) -> void:
	if ONESHOTS.has(action):
		_shot = action
		_shot_t = 0.0
		_shot_len = duration if duration > 0.0 else float(ONESHOTS[action])
		_on_shot_start(action)
	elif action in LOOP_ACTIONS:
		if action == _loop:
			return
		_prev_loop = _loop
		_prev_loop_w = _loop_w if _loop != "idle" else 0.0
		_loop = action
		_loop_t = 0.0
		_loop_w = 0.0
		_fid = ""
		if action == "sleep":
			_zzz_t = 1.4
	else:
		push_warning("Cometling: unknown action '%s'" % action)


## Queues one-shots to play one after another (e.g. ["surprise", "cheer"]).
func play_sequence(actions: Array) -> void:
	_queue.clear()
	for a in actions:
		_queue.append(String(a))
	if _shot == "" and not _queue.is_empty():
		play(_queue.pop_front())


## Cancels the running one-shot and anything queued (the loop keeps playing).
func stop_shot() -> void:
	_queue.clear()
	_shot = ""


func current_action() -> String:
	return _shot if _shot != "" else _loop


func is_busy() -> bool:
	return _shot != "" or not _queue.is_empty()


static func has_action(action: String) -> bool:
	return action in LOOP_ACTIONS or ONESHOTS.has(action)


## Every loop action and one-shot name.
static func all_actions() -> Array[String]:
	var out: Array[String] = []
	for a in LOOP_ACTIONS:
		out.append(String(a))
	for a in ONESHOTS:
		out.append(String(a))
	return out


func look_at_point(p: Vector3, weight := 1.0) -> void:
	look_target = p
	look_weight = weight


func clear_look() -> void:
	look_weight = 0.0


## Face on top of whatever plays (EXPRESSIONS); duration <= 0 keeps it until cleared.
## One-shots still show their own face while they play.
func set_expression(expr: String, duration := -1.0) -> void:
	if expr == "" or expr == "neutral":
		clear_expression()
		return
	if not expr in EXPRESSIONS:
		push_warning("Cometling: unknown expression '%s'" % expr)
		return
	if _expr != expr and _expr_w > 0.0:
		_expr_w = 0.35          # quick cross-fade from the previous face
	_expr = expr
	_expr_on = true
	_expr_left = duration


func clear_expression() -> void:
	_expr_on = false
	_expr_left = -1.0


func current_expression() -> String:
	return _expr if _expr_on else "neutral"


## Reaction to something happening in the hangar or on the campus. Known events:
## part_placed, part_removed, vessel_cleared, launch, success, failure, hello, staged,
## level_up, hired, good_news, bad_news, idea, tired, scared, poke.
func react(event: String) -> void:
	match event:
		"part_placed":
			play_sequence(["surprise", ["cheer", "jump", "spin", "clap"][_rng.randi() % 4]])
			show_emote(["exclaim", "star", "sparkle"][_rng.randi() % 3])
		"part_removed":
			play_sequence(["surprise", "nod"])
			show_emote("sweat")
		"vessel_cleared":
			play_sequence(["surprise", "shrug"])
			show_emote("question")
		"launch":
			play_sequence(["cheer", "jump", "cheer"])
			show_emote(["rocket", "heart", "fire"][_rng.randi() % 3])
		"success":
			play_sequence([["cheer", "celebrate"][_rng.randi() % 2], "jump", "clap"])
			show_emote(["rocket", "heart", "fire"][_rng.randi() % 3])
			set_expression("joy", 6.0)
		"failure":
			play_sequence(["surprise", "sigh"])
			show_emote("sweat")
			set_expression("sad", 5.0)
		"hello", "hired":
			play_sequence(["wave"] if event == "hello" else ["wave", "bow"])
			show_emote("happy")
		"staged":
			play_sequence(["nod"])
			show_emote("idea")
		"level_up":
			play_sequence(["celebrate", "salute"])
			show_emote(["star", "sparkle"][_rng.randi() % 2])
			set_expression("joy", 4.0)
		"good_news":
			play_sequence(["hop", "clap"])
			show_emote(["heart", "happy", "check"][_rng.randi() % 3])
			set_expression("happy", 4.0)
		"bad_news":
			play_sequence(["startled" if _rng.randf() < 0.3 else "surprise", "shake_head", "sigh"])
			show_emote("sweat")
			set_expression("worried", 5.0)
		"idea":
			play_sequence(["hop", "point"])
			show_emote("idea")
		"tired":
			play_sequence(["yawn"])
			show_emote("zzz")
			set_expression("sleepy", 4.0)
		"scared":
			play_sequence(["startled"])
			show_emote("exclaim")
			set_expression("worried", 2.5)
		"poke":
			poke()
		_:
			play_sequence(["surprise"])
			show_emote("exclaim")


## A random, cute reaction to being clicked or tickled.
func poke() -> void:
	match _rng.randi() % 6:
		0:
			play_sequence(["surprise", "laugh"])
			show_emote("happy")
		1:
			play_sequence(["hop", "wave"])
			show_emote("heart")
		2:
			play_sequence(["startled", "laugh"])
			show_emote("exclaim")
		3:
			play_sequence(["spin"])
			show_emote("sparkle")
		4:
			play_sequence(["laugh"])
			show_emote("note")
		_:
			play_sequence(["salute"])
			show_emote("star")
	_kick = maxf(_kick, 0.6)


func show_emote(emote: String, duration := 1.8) -> void:
	var i := EMOTES.find(emote)
	if i < 0 or emote_sprite == null:
		return
	emote_sprite.frame = i
	emote_sprite.visible = true
	_emote_t = 0.0
	_emote_len = duration
	emoted.emit(emote)
	if emote_hook.is_valid():
		emote_hook.call(self, emote)


func set_colors(body: Color, spot: Color, glow := Color(0, 0, 0, 0)) -> void:
	body_color = body
	spot_color = spot
	glow_color = glow


func effective_glow() -> Color:
	return glow_color if glow_color.a > 0.0 else ROLE_GLOW.get(role, ROLE_GLOW["ground"])


# ================================================================== look & role
func _apply_colors() -> void:
	if not _ready_done:
		return
	var g := effective_glow()
	for m in _meshes:
		m.set_instance_shader_parameter("body_tint", body_color)
		m.set_instance_shader_parameter("spot_tint", spot_color)
		m.set_instance_shader_parameter("glow_tint", g)


func _apply_role() -> void:
	if not _ready_done:
		return
	var acc := {"Helmet": "pilot", "Scarf": "pilot", "HardHat": "engineer", "Belt": "engineer",
		"Goggles": "scientist", "Backpack": "scientist", "Vest": "ground"}
	for n in acc:
		var node := find_child(n, true, false) as Node3D
		if node:
			node.visible = acc[n] == role
	_apply_colors()


func _on_bus_event(event: String, data: Dictionary) -> void:
	if not is_inside_tree() or not is_visible_in_tree():
		return
	# optional radius: only creatures near data.position react
	if data.has("position") and data.has("radius"):
		var p: Vector3 = data["position"]
		if p.distance_to(global_position) > float(data["radius"]):
			return
	var delay := _rng.randf_range(0.0, float(data.get("stagger", 0.35)))
	if delay <= 0.01:
		react(event)
	else:
		get_tree().create_timer(delay).timeout.connect(func() -> void:
			if is_inside_tree():
				react(event))


# ================================================================== timers
func _tick_timers(dt: float) -> void:
	_t += dt
	_loop_t += dt
	_loop_w = minf(1.0, _loop_w + dt / 0.3)
	_prev_loop_w = maxf(0.0, _prev_loop_w - dt / 0.3)
	var mp := maxf(mood, 0.0)
	var mn := maxf(-mood, 0.0)
	_breath = fmod(_breath + dt * TAU * breath_rate * _tempo * (1.0 - mn * 0.25 + mp * 0.1), TAU)
	if _shot != "":
		_shot_t += dt
		if _shot_t >= _shot_len:
			var done := _shot
			_shot = ""
			action_finished.emit(done)
			if not _queue.is_empty():
				play(_queue.pop_front())
	# blinking (sometimes a double blink)
	if _blink_t >= 0.0:
		_blink_t += dt
		if _blink_t > 0.16:
			_blink_t = -1.0
			if _blink_double:
				_blink_double = false
				_blink_next = 0.12
	else:
		_blink_next -= dt
		if _blink_next <= 0.0:
			_blink_t = 0.0
			_blink_double = _rng.randf() < 0.25
			_blink_next = _rng.randf_range(blink_interval.x, maxf(blink_interval.y, blink_interval.x))
	# idle glances (a big head turn often comes with a blink, like a real look)
	_glance_next -= dt
	if _glance_next <= 0.0:
		_glance_next = _rng.randf_range(0.8, 3.2) / _curious
		var g := Vector2(_rng.randf_range(-0.5, 0.5), _rng.randf_range(-0.15, 0.2)) \
			if _rng.randf() < 0.7 else Vector2.ZERO
		if g.distance_to(_glance_target) > 0.35 and _blink_t < 0.0 and _rng.randf() < 0.6:
			_blink_t = 0.0
		_glance_target = g
	# eye darts: quick saccades between glances
	_dart_next -= dt
	if _dart_next <= 0.0:
		_dart_next = _rng.randf_range(0.35, 2.0)
		_dart_target = Vector2(_rng.randf_range(-1.0, 1.0), _rng.randf_range(-0.6, 0.6)) \
			if _rng.randf() < 0.6 else Vector2.ZERO
	# weight shift: slow sway from one foot to the other
	_shift = lerpf(_shift, _shift_target, 1.0 - exp(-2.2 * dt))
	# expression fade
	if _expr_left > 0.0:
		_expr_left -= dt
		if _expr_left <= 0.0:
			_expr_on = false
	_expr_w = clampf(_expr_w + (dt if _expr_on else -dt) / 0.25, 0.0, 1.0)
	if _expr_w <= 0.0 and not _expr_on:
		_expr = ""
	# idle habits
	if _fid != "":
		_fid_t += dt
		if _fid_t >= _fid_len or _loop != "idle" or _shot != "":
			_fid = ""
	elif fidgets:
		_fid_next -= dt
		if _fid_next <= 0.0:
			_start_fidget()
			_fid_next = _rng.randf_range(fidget_interval.x, maxf(fidget_interval.y, fidget_interval.x)) \
				/ _energy * (1.0 + mn * 0.8) / (1.0 + mp * 0.5)
	# naps snore
	if _loop == "sleep" and auto_emotes and not Engine.is_editor_hint():
		_zzz_t -= dt
		if _zzz_t <= 0.0:
			_zzz_t = _rng.randf_range(2.8, 3.8)
			if _emote_t < 0.0:
				show_emote("zzz", 2.2)
	# emote bubble
	if _emote_t >= 0.0:
		_emote_t += dt
		if _emote_t > _emote_len:
			_emote_t = -1.0
			emote_sprite.visible = false


func _start_fidget() -> void:
	if not _habits_ok:
		return
	var idle := _loop == "idle" and _shot == "" and _queue.is_empty() and _speed < 0.05
	var mp := maxf(mood, 0.0)
	var mn := maxf(-mood, 0.0)
	var watching := look_weight > 0.5
	# weights, same order as _FIDGETS
	_fid_w[0] = 0.0 if watching else 2.6 * _curious                  # look_around
	_fid_w[1] = 0.0 if watching else 1.8 * _curious                  # head_tilt
	_fid_w[2] = 1.0 + 2.0 * mp                                       # toe_bounce
	_fid_w[3] = 1.2 + 2.2 * mp                                       # tail_wag
	_fid_w[4] = 0.9 * (1.0 - mp * 0.6) + mn                          # shy
	_fid_w[5] = 2.6                                                  # weight_shift
	_fid_w[6] = 2.8                                                  # ear_flick
	_fid_w[7] = 1.4                                                  # antenna_boing
	_fid_w[8] = 0.6 + 2.4 * mp                                       # hop
	_fid_w[9] = 0.35 * _sleepy + mn * 0.8                            # yawn
	_fid_w[10] = 0.4                                                 # stretch
	_fid_w[11] = mn * 2.5                                            # sigh
	if not idle:
		# at work or walking only the tiny ones
		for i in _fid_w.size():
			if i != 6 and i != 7:
				_fid_w[i] = 0.0
	var total := 0.0
	for w in _fid_w:
		total += w
	if total <= 0.0:
		return
	var r := _rng.randf() * total
	var pick := 0
	for i in _fid_w.size():
		r -= _fid_w[i]
		if r <= 0.0:
			pick = i
			break
	var f: String = _FIDGETS[pick]
	_fid_last = f
	var side := 1.0 if _rng.randf() < 0.5 else -1.0
	match f:
		"weight_shift":
			_shift_target = -signf(_shift_target) if _shift_target != 0.0 else side
		"ear_flick":
			if side > 0.0:
				_sp_ear_l.y += 9.0
			else:
				_sp_ear_r.y += 9.0
			if _rng.randf() < 0.3:
				_sp_ear_spread.y += 5.0
		"antenna_boing":
			_sp_ant_z.y += 10.0 * side
			_sp_ant_x.y -= 4.0
		"hop", "yawn", "stretch", "sigh":
			play(f)
		_:
			_fid = f
			_fid_t = 0.0
			_fid_len = float(_FIDGET_LEN.get(f, 2.0)) * _rng.randf_range(0.85, 1.2)
			_fid_side = side


func _on_shot_start(action: String) -> void:
	match action:
		"surprise":
			_kick = 1.0
		"jump":
			_kick = 0.5
		"startled":
			_kick = 1.25
		"celebrate", "laugh":
			_kick = 0.4
		"hop", "clap":
			_kick = 0.2


# ================================================================== the animation
static func _ease_out_back(x: float) -> float:
	var c1 := 1.70158
	var c3 := c1 + 1.0
	return 1.0 + c3 * pow(x - 1.0, 3) + c1 * pow(x - 1.0, 2)


static func _smooth(x: float) -> float:
	x = clampf(x, 0.0, 1.0)
	return x * x * (3.0 - 2.0 * x)


## 0 -> 1 -> 0 over x in [0, 1].
static func _bump(x: float) -> float:
	return sin(clampf(x, 0.0, 1.0) * PI)


## Damped spring (value, velocity), sub-stepped so long frames (LOD updates) stay stable.
static func _spring(s: Vector2, target: float, freq: float, damp: float, dt: float) -> Vector2:
	var w := TAU * freq
	var steps := clampi(ceili(dt / 0.012), 1, 12)
	var h := dt / steps
	for i in steps:
		var acc := w * w * (target - s.x) - 2.0 * damp * w * s.y
		s.y += acc * h
		s.x += s.y * h
	if not is_finite(s.x) or not is_finite(s.y):
		return Vector2(target, 0.0)
	return Vector2(clampf(s.x, -3.0, 3.0), clampf(s.y, -60.0, 60.0))


func _yaw_now() -> float:
	if not is_inside_tree():
		return 0.0
	var z := global_basis.z
	return atan2(z.x, z.z)


func _animate(dt: float) -> void:
	if not _ready_done:
		return
	var prev_speed := _speed_s
	_speed_s = lerpf(_speed_s, _speed, 1.0 - exp(-8.0 * dt))
	# inertia: speeding up tips the body back, slowing down tips it forward (then it rocks back)
	_sp_lean.y = clampf(_sp_lean.y - (_speed_s - prev_speed) * lean_inertia * 6.0, -6.0, 6.0)
	var walk := clampf(_speed_s / 0.5, 0.0, 1.0)
	var run := clampf((_speed_s - run_speed.x) / maxf(run_speed.y - run_speed.x, 0.01), 0.0, 1.0)
	# stride grows into a run, but never slower than a lazy shuffle
	var step_len := maxf(lerpf(stride, run_stride, run), 0.03)
	var cadence := maxf(_speed_s / step_len, 2.2 if walk > 0.05 else 0.0)
	_phase = fmod(_phase + dt * cadence * PI, TAU * 64.0)
	# how fast the parent turns (lean into turns, head leads)
	if dt > 0.0:
		var yaw := _yaw_now()
		var rate := clampf(angle_difference(_last_yaw, yaw) / dt, -10.0, 10.0)
		_last_yaw = yaw
		_yaw_rate = lerpf(_yaw_rate, rate, 1.0 - exp(-10.0 * dt))

	var p := _p
	p.reset()
	_pose_idle(p)
	if _fid != "":
		_pose_fidget(p)
	if walk > 0.0:
		_tmp.copy_from(p)
		_pose_walk(_tmp, walk, run)
		p.blend(_tmp, minf(1.0, walk * 2.0))
	# loop action (with a cross-fade from the previous one)
	if _prev_loop_w > 0.0 and _prev_loop != "idle":
		_tmp.copy_from(p)
		_pose_loop(_tmp, _prev_loop, _loop_t + 10.0, walk)
		_keep_walk_legs(_tmp, p, _prev_loop, walk)
		p.blend(_tmp, _smooth(_prev_loop_w))
	if _loop != "idle":
		_tmp.copy_from(p)
		_pose_loop(_tmp, _loop, _loop_t, walk)
		_keep_walk_legs(_tmp, p, _loop, walk)
		p.blend(_tmp, _smooth(_loop_w))
	if _expr_w > 0.0 and _expr != "":
		_pose_expression(p, _smooth(_expr_w))
	# one-shot on top, eased in and out
	if _shot != "":
		_tmp.copy_from(p)
		_pose_shot(_tmp, _shot, _shot_t, _shot_len)
		var w := _smooth(_shot_t / 0.12) * _smooth((_shot_len - _shot_t) / 0.2)
		p.blend(_tmp, w)
	# turning: lean into the turn, the head leads, the tail swings out
	p.roll -= clampf(_yaw_rate * turn_lean, -0.2, 0.2) * (0.3 + 0.7 * walk)
	p.head.y += clampf(_yaw_rate * head_lead, -0.45, 0.45)
	p.tail_wag -= clampf(_yaw_rate * 0.08, -0.4, 0.4)
	_apply_look(p, dt)
	_apply(p, dt)


## Stationary loops played while walking keep the walking legs and height.
func _keep_walk_legs(lp: Pose, base: Pose, action: String, walk: float) -> void:
	if not action in _STATIONARY:
		return
	var k := _smooth((walk - 0.15) / 0.3)
	if k <= 0.0:
		return
	lp.rig_y = lerpf(lp.rig_y, base.rig_y, k)
	lp.rig_z = lerpf(lp.rig_z, base.rig_z, k)
	lp.foot_l = lp.foot_l.lerp(base.foot_l, k)
	lp.foot_r = lp.foot_r.lerp(base.foot_r, k)
	lp.foot_pitch = lp.foot_pitch.lerp(base.foot_pitch, k)


func _pose_idle(p: Pose) -> void:
	var mp := maxf(mood, 0.0)
	var mn := maxf(-mood, 0.0)
	var br := sin(_breath)
	var depth := breath_depth
	p.squash = 1.0 + br * 0.018 * depth - mn * 0.025
	p.hips_y = br * 0.004 * depth
	p.head_y = sin(_breath - 0.6) * 0.006 * depth
	p.head.z = sin(_t * 0.7 * _tempo) * 0.05
	p.head.x = sin(_t * 0.53 * _tempo) * 0.03 + mn * 0.16 - mp * 0.04
	# weight on one foot, the other relaxed; the head balances the other way
	p.hips_roll = sin(_t * 0.9 * _tempo) * 0.02 - _shift * 0.04
	p.hips_x = _shift * 0.012
	p.head.z += _shift * 0.035
	var relax_r := maxf(_shift, 0.0)
	var relax_l := maxf(-_shift, 0.0)
	p.foot_r = Vector3(-0.004 * relax_r, 0.004 * relax_r, 0.01 * relax_r)
	p.foot_l = Vector3(0.004 * relax_l, 0.004 * relax_l, 0.01 * relax_l)
	p.foot_pitch = Vector2(-0.12 * relax_l, -0.12 * relax_r)
	var arm_out := 0.12 + br * 0.04 * depth + mp * 0.06 - mn * 0.06
	p.arm_l = Vector3(sin(_t * 1.1) * 0.05, 0, arm_out)
	p.arm_r = Vector3(sin(_t * 1.1 + 1.0) * 0.05, 0, arm_out)
	p.ear_lift = mood * 0.16
	var wag := 0.25 * (1.0 + mp * 0.9 - mn * 0.75)
	p.tail_wag = sin(_t * (2.3 + mp * 2.5)) * wag + sin(_t * 5.1) * 0.05
	p.tail_lift = mood * 0.3
	p.bulb_pulse = (0.85 + 0.25 * (0.5 + 0.5 * sin(_t * 2.6))) * (1.0 - mn * 0.35)
	if mn > 0.0:
		p.lid = mn * 0.4
		p.lid_tilt = mn * 0.5
		if mood < -0.55:
			p.mouth = 3
	if mp > 0.5:
		p.eye_squash = 1.0 - (mp - 0.5) * 0.3


## Idle habits, added on top of the idle pose.
func _pose_fidget(p: Pose) -> void:
	var u := _fid_t / _fid_len
	var e := _bump(u)
	var t := _fid_t
	var s := _fid_side
	match _fid:
		"look_around":
			var sw := sin(u * TAU) * s * _smooth(u * 4.0)
			p.head.y += sw * 0.62
			p.hips_yaw += sw * 0.12
			p.head.x -= 0.07 * e
			p.eye_off.x += sw * 0.9
			p.ear_lift += 0.1 * e
		"head_tilt":
			p.head.z += s * 0.3 * e
			p.head.x -= 0.05 * e
			p.ear_lift += 0.18 * e
			p.ear_spread += 0.08 * e
			p.eye_scale += 0.06 * e
			p.tail_wag += sin(t * 6.0) * 0.2 * e
		"toe_bounce":
			var b := absf(sin(t * TAU * 2.0))
			p.rig_y += b * 0.022 * e
			p.squash += (b - 0.4) * 0.04 * e
			p.arm_l.z += 0.18 * e
			p.arm_r.z += 0.18 * e
			p.head.z += sin(t * TAU) * 0.08 * e
			p.eye_squash -= 0.12 * e
		"tail_wag":
			p.tail_wag += sin(t * 15.0) * 0.7 * e
			p.tail_lift += 0.35 * e
			p.hips_roll += sin(t * 7.5) * 0.04 * e
			p.eye_squash -= 0.15 * e
		"shy":
			# paws behind the back, sway, a toe drawing little circles, bashful eyes
			p.arm_l = p.arm_l.lerp(Vector3(0.6, 0.0, 0.04), e)
			p.arm_r = p.arm_r.lerp(Vector3(0.6, 0.0, 0.04), e)
			p.hips_yaw += sin(t * 2.2) * 0.18 * e
			p.head.x += 0.16 * e
			p.head.z += 0.12 * e * s
			p.foot_r += Vector3(sin(t * 4.0) * 0.018, 0.012, cos(t * 4.0) * 0.018 + 0.03) * e
			p.foot_pitch.y += -0.45 * e
			p.eye_squash -= 0.12 * e
			p.eye_off.y -= 0.5 * e
			p.ear_lift -= 0.1 * e


func _pose_walk(p: Pose, walk: float, run: float) -> void:
	var s := sin(_phase)
	var c := cos(_phase)
	var bounce := absf(s)                       # 0 at foot contact, 1 mid-step
	var contact := 1.0 - bounce
	var amp := walk_bounce * (1.0 + run * 0.7)
	p.hips_y = bounce * 0.035 * (0.6 + walk * 0.6) * amp
	p.rig_y = bounce * 0.035 * run * walk_bounce
	p.squash = 1.0 - pow(contact, 6.0) * 0.08 * amp + pow(bounce, 2.0) * 0.045 * amp
	p.hips_roll = c * 0.07 * (1.0 - run * 0.4)
	p.hips_yaw = c * 0.08 * (1.0 + run * 0.5)
	p.lean = 0.06 + walk * 0.08 + run * 0.14
	# the head stays level while the body leans into the run
	p.head = Vector3(-0.02 - bounce * 0.04 - run * 0.1, -c * 0.05, -c * 0.05 * (1.0 - run * 0.5))
	p.head_y = -bounce * 0.008
	var step := 0.07 * (0.5 + walk * 0.5) * (1.0 + run * 0.45)
	var lift := 0.06 + run * 0.035
	p.foot_l = Vector3(0, maxf(0.0, s) * lift, c * step)
	p.foot_r = Vector3(0, maxf(0.0, -s) * lift, -c * step)
	p.foot_pitch = Vector2(-maxf(0.0, s) * 0.5 + 0.15 * c, -maxf(0.0, -s) * 0.5 - 0.15 * c)
	var swing := (0.6 + run * 0.45) * walk * arm_swing
	var out := 0.22 + run * 0.16 + bounce * 0.04
	p.arm_l = Vector3(c * swing - run * 0.35, 0, out)
	p.arm_r = Vector3(-c * swing - run * 0.35, 0, out)
	p.tail_wag = sin(_phase * 0.5) * 0.4
	p.tail_lift = 0.25 + run * 0.25
	p.ear_lift += run * 0.1
	if run > 0.55:
		p.mouth = 1


func _pose_loop(p: Pose, action: String, t: float, walk: float) -> void:
	match action:
		"sit":
			var br := sin(t * TAU * 0.25)
			p.rig_y = -0.13
			p.squash = 0.95 + br * 0.02
			p.foot_l = Vector3(0.03, 0.12, 0.17)
			p.foot_r = Vector3(-0.03, 0.12, 0.17)
			p.foot_pitch = Vector2(-1.25 + sin(t * 2.2) * 0.25, -1.25 + sin(t * 2.2 + 1.3) * 0.25)
			p.hips_pitch = -0.2
			p.head = Vector3(0.12 + br * 0.03, sin(t * 0.4) * 0.25, sin(t * 0.6) * 0.12)
			p.arm_l = Vector3(-0.35, 0, 0.35)
			p.arm_r = Vector3(-0.35, 0, 0.35)
			p.lid = 0.45 + 0.1 * br
			p.tail_wag = sin(t * 1.2) * 0.3
			p.tail_lift = -0.35
			p.ear_lift = -0.15
		"look_up":
			var sw := sin(t * 1.3)
			p.hips_pitch = -0.1
			p.lean = -0.06
			p.head.z = sw * 0.08
			p.arm_l = Vector3(0.35, 0, 0.18)
			p.arm_r = Vector3(0.35, 0, 0.18)
			p.mouth = 2
			p.eye_scale = 1.08
			p.ear_lift = 0.15
			p.tail_wag = sin(t * 3.0) * 0.5
			# now and then a tiny awed bounce on the toes
			var awe := _bump((fmod(t, 6.5) - 5.3) / 0.9)
			p.rig_y += absf(sin(t * TAU * 2.2)) * 0.02 * awe
			p.eye_scale += 0.08 * awe
		"work_hammer":
			var cyc := fmod(t, 0.8) / 0.8
			var up := _smooth(cyc / 0.62)                           # slow wind-up
			var strike := clampf((cyc - 0.62) / 0.1, 0.0, 1.0)
			strike = strike * strike * strike
			var impact := clampf(1.0 - (cyc - 0.72) / 0.28, 0.0, 1.0) if cyc > 0.72 else 0.0
			var arm := lerpf(-0.9, -2.5, up)
			arm = lerpf(arm, -0.75, strike)
			p.arm_r = Vector3(arm + impact * 0.08, 0.1, 0.1)
			p.arm_l = Vector3(-0.9, 0, 0.2)
			p.hips_pitch = 0.12 + impact * 0.05 - up * 0.04 * (1.0 - strike)
			p.squash = 1.0 - impact * impact * 0.07 + up * 0.03 * (1.0 - strike)
			p.head = Vector3(0.16 + impact * 0.08, 0.1, 0.0)
			p.mouth = 0 if impact < 0.4 else 2
			p.eye_squash = 1.0 - impact * 0.35
			p.item = "hammer"
			p.tail_wag = sin(t * 4.0) * 0.4
			if impact > 0.95 and _rng.randf() < 0.05:
				_kick = maxf(_kick, 0.25)
		"work_scan":
			var sweep := sin(t * TAU * 0.35)
			p.arm_l = Vector3(-1.15, 0, 0.32)
			p.arm_r = Vector3(-1.15, 0, 0.32)
			p.hips_yaw = sweep * 0.35
			p.head = Vector3(0.22 + sin(t * 3.1) * 0.04, sweep * 0.25, sweep * 0.06)
			p.eye_off = Vector2(sweep * 0.5, -0.4)
			p.item = "scanner"
			p.bulb_pulse = 1.0 + 0.5 * (0.5 + 0.5 * sin(t * 9.0))
			p.mouth = 2 if fmod(t, 4.0) > 3.2 else 0
			p.tail_wag = sweep * 0.3
		"carry":
			p.arm_l = Vector3(-1.2, 0, 0.42)
			p.arm_r = Vector3(-1.2, 0, 0.42)
			p.hips_pitch = -0.08
			p.lean = 0.02
			p.squash -= 0.02
			p.head = Vector3(-0.08, p.head.y * 0.5, p.head.z)
			p.item = "crate"
			p.mouth = 0
			# the load bobs with the steps; standing still, a little re-grip hop now and then
			var bob := sin(_phase * 2.0) * 0.05 * walk
			p.arm_l.x += bob
			p.arm_r.x += bob
			var grip := _bump((fmod(t, 5.0) - 4.4) / 0.45) * (1.0 - walk)
			p.rig_y += grip * 0.025
			p.arm_l.x -= grip * 0.12
			p.arm_r.x -= grip * 0.12
			p.eye_squash -= grip * 0.3
		"clipboard":
			var w2 := sin(t * 7.0)
			p.arm_l = Vector3(-1.0, 0.2, 0.35)
			p.arm_r = Vector3(-0.85 + w2 * 0.06, 0, 0.3 + w2 * 0.04)
			p.head = Vector3(0.3, -0.1 + sin(t * 0.8) * 0.12, 0.08)
			p.eye_off = Vector2(sin(t * 1.6) * 0.5, -0.5)
			p.item = "clipboard"
			p.mouth = 2 if fmod(t, 3.0) > 2.4 else 0
			if fmod(t, 3.0) > 2.4:
				p.head.x = 0.1
			# tick a box: the pen hand flicks and the head nods
			var tick := _bump((fmod(t, 3.0) - 1.5) / 0.35)
			p.arm_r.x -= tick * 0.2
			p.arm_r.z += tick * 0.06
			p.head.x += tick * 0.08
		"talk":
			var g1 := sin(t * 3.4)
			var g2 := sin(t * 2.1 + 1.0)
			p.head = Vector3(sin(t * 6.0) * 0.06, p.head.y, sin(t * 1.7) * 0.12)
			p.head.x += pow(maxf(0.0, sin(t * 2.3)), 4.0) * 0.12    # emphasis nods
			p.arm_l = Vector3(-0.5 - maxf(0.0, g1) * 0.7, 0, 0.25 + maxf(0.0, g1) * 0.3)
			p.arm_r = Vector3(-0.5 - maxf(0.0, g2) * 0.7, 0, 0.25 + maxf(0.0, g2) * 0.3)
			p.mouth = 1 if fmod(t * 5.0, 2.0) < 1.0 and fmod(t, 3.0) < 2.2 else 0
			p.squash = 1.0 + sin(t * 6.0) * 0.015
			p.tail_wag = sin(t * 4.0) * 0.4
			# a shared laugh every few seconds
			if fmod(t, 6.0) > 5.25:
				p.happy = true
				p.mouth = 1
				p.squash += sin(t * 30.0) * 0.02
		"dance":
			var b := sin(t * TAU * 1.0)
			var bb := absf(sin(t * TAU * 1.0))
			p.rig_y = bb * 0.03
			p.squash = 1.0 - (1.0 - bb) * 0.06
			p.hips_roll = b * 0.16
			p.roll = b * 0.05
			p.head = Vector3(-0.05, b * 0.15, -b * 0.18)
			p.arm_l = Vector3(-0.3 + b * 0.5, 0, 1.6 + b * 0.5)
			p.arm_r = Vector3(-0.3 - b * 0.5, 0, 1.6 - b * 0.5)
			p.foot_l = Vector3(0, maxf(0.0, b) * 0.05, 0)
			p.foot_r = Vector3(0, maxf(0.0, -b) * 0.05, 0)
			p.happy = true
			p.mouth = 1
			p.tail_wag = b * 0.7
			# every 8 beats a little twirl
			var tw := _smooth((fmod(t, 8.0) - 7.0) / 0.9)
			p.hips_yaw = tw * TAU if tw < 1.0 else 0.0
		"sleep":
			# nap sitting down: slow deep breaths, head nodding off and jerking back up
			var br := sin(t * TAU * 0.2)
			var cyc := fmod(t, 7.0)
			var nod := _smooth((cyc - 3.8) / 1.8) * (1.0 - _smooth((cyc - 5.8) / 0.15))
			p.rig_y = -0.13
			p.squash = 0.95 + br * 0.035
			p.foot_l = Vector3(0.035, 0.12, 0.17)
			p.foot_r = Vector3(-0.035, 0.12, 0.17)
			p.foot_pitch = Vector2(-1.2, -1.25)
			p.hips_pitch = 0.06 + br * 0.02
			p.head = Vector3(0.28 + nod * 0.2 + br * 0.03, 0.12, 0.22 + nod * 0.05)
			p.head_y = -0.008
			p.arm_l = Vector3(-0.3, 0, 0.16)
			p.arm_r = Vector3(-0.3, 0, 0.16)
			p.eye_close = 1.0
			p.mouth = 2
			p.mouth_size = 0.45 + 0.25 * (0.5 + 0.5 * br)
			p.ear_lift = -0.5 - nod * 0.15
			p.tail_wag = sin(t * 0.6) * 0.15
			p.tail_lift = -0.45
			p.bulb_pulse = 0.3 + 0.2 * (0.5 + 0.5 * br)
			if cyc > 5.8 and cyc < 5.9:
				_kick = maxf(_kick, 0.35)
		"think":
			# paw on the chin, head tilted, eyes up; every few seconds an idea lights the bulb
			var tilt := clampf(sin(t * TAU / 9.0) * 2.5, -1.0, 1.0)
			var cyc := fmod(t, 9.0)
			var idea := _bump((cyc - 6.6) / 1.1)
			p.arm_r = Vector3(-2.15 + sin(t * 1.7) * 0.05, 0.0, -0.42)
			p.arm_l = Vector3(-0.95, 0.0, -0.3)
			p.arm_r = p.arm_r.lerp(Vector3(-2.9, 0.0, 0.15), idea)
			p.head = Vector3(-0.12 + sin(t * 0.9) * 0.03 - idea * 0.08, 0.12 * tilt, 0.16 * tilt)
			p.hips_roll = -0.03 * tilt
			p.lid = 0.18 * (1.0 - idea)
			p.eye_off = Vector2(0.45 * tilt, 0.8)
			p.eye_scale = 1.0 + 0.2 * idea
			p.mouth = 1 if idea > 0.4 else (2 if fmod(t, 4.5) > 3.4 else 0)
			p.mouth_size = 1.0 if idea > 0.4 else 0.6
			p.ear_lift = -0.05 + 0.45 * idea
			p.tail_wag = sin(t * 1.1) * 0.35
			p.foot_pitch.x = -0.35 * maxf(0.0, sin(t * TAU * 1.3)) * (1.0 - idea)
			p.bulb_pulse = 0.8 + 0.3 * sin(t * 1.5) + 1.6 * idea
			p.rig_y += idea * 0.02
		"sad":
			var br := sin(t * TAU * 0.18)
			var sniff := _bump((fmod(t, 5.0) - 4.2) / 0.3)
			p.squash = 0.95 + br * 0.012 + sniff * 0.02
			p.hips_pitch = 0.12
			p.lean = 0.02
			p.head = Vector3(0.32 + br * 0.02 - sniff * 0.08, sin(t * 0.3) * 0.12, 0.08)
			p.arm_l = Vector3(-0.2, 0, 0.04)
			p.arm_r = Vector3(-0.2, 0, 0.04)
			p.ear_lift = -0.6
			p.ear_spread = -0.05
			p.tail_wag = sin(t * 0.5) * 0.08
			p.tail_lift = -0.55
			p.lid = 0.4
			p.lid_tilt = 0.5
			p.eye_scale = 1.06
			p.eye_off = Vector2(0.0, -0.6)
			p.mouth = 3
			p.mouth_size = 0.85
			p.bulb_pulse = 0.45
			var sc := sin(t * 1.4)
			p.foot_r += Vector3(0, 0.005 + 0.01 * maxf(0.0, sc), sc * 0.025)
			p.foot_pitch.y += -0.2 * maxf(0.0, sc)
		"work_type":
			# typing bursts, then a pause to read the screen
			var cyc := fmod(t, 4.5)
			var tb := _smooth(cyc / 0.2) * _smooth((3.4 - cyc) / 0.2)
			var tl := maxf(0.0, sin(t * TAU * 4.3))
			var tr := maxf(0.0, sin(t * TAU * 4.3 + 2.1 + sin(t * 1.3)))
			p.arm_l = Vector3(-1.3 - tl * 0.16 * tb, 0.0, 0.06)
			p.arm_r = Vector3(-1.3 - tr * 0.16 * tb, 0.0, 0.06)
			p.hips_pitch = 0.08
			p.head = Vector3(0.2 + tb * sin(t * 9.0) * 0.015 - (1.0 - tb) * 0.06, sin(t * 0.7) * 0.1 * (1.0 - tb),
				0.06 * (1.0 - tb))
			p.squash = 1.0 + (tl + tr) * 0.006 * tb
			p.eye_off = Vector2(sin(t * 2.0) * 0.6 * tb, -0.3)
			p.mouth = 2 if tb < 0.5 and fmod(t, 9.0) > 4.5 else 0
			p.mouth_size = 0.6 if p.mouth == 2 else 1.0
			p.bulb_pulse = 0.9 + (tl + tr) * 0.35 * tb
			p.tail_wag = sin(t * 2.0) * 0.2
		"work_wrench":
			# ratchet a bolt: slow effortful pull, quick return; a happy beat when it is tight
			var cyc := fmod(t, 1.1) / 1.1
			var pull := _smooth(cyc / 0.55) if cyc < 0.55 else 1.0 - _smooth((cyc - 0.55) / 0.45)
			var done := _bump((fmod(t, 6.6) - 5.7) / 0.8)
			pull *= 1.0 - done
			p.item = "wrench"
			p.arm_r = Vector3(-1.35 + pull * 0.15, 0.25 * pull, 0.15 + pull * 0.55)
			p.arm_l = Vector3(-1.1, 0.0, 0.1)
			p.hips_pitch = 0.12
			p.hips_yaw = -0.12 * pull
			p.hips_roll = 0.04 * pull
			p.squash = 1.0 - 0.035 * pull + done * 0.03
			p.head = Vector3(0.2 - done * 0.15, -0.08 * pull, -0.06 * pull + done * 0.1)
			p.lid = 0.25 * pull
			p.eye_squash = 1.0 - 0.25 * pull
			p.mouth = 3 if pull > 0.6 else 0
			p.mouth_size = 0.7 if pull > 0.6 else 1.0
			p.ear_lift = -0.1 * pull + 0.3 * done
			p.tail_wag = pull * 0.3 + sin(t * 12.0) * 0.4 * done
			if done > 0.5:
				p.happy = true
				p.mouth = 1


func _pose_shot(p: Pose, action: String, t: float, length: float) -> void:
	var u := t / length
	match action:
		"wave":
			var osc := sin(t * 13.0)
			p.arm_r = Vector3(-0.35, 0.0, 2.05 + osc * 0.32)
			p.arm_l = Vector3(0.1, 0, 0.3)
			p.head = Vector3(-0.05, p.head.y, -0.16 + osc * 0.03)
			p.hips_roll = -0.06
			p.mouth = 1
			p.squash = 1.0 + sin(t * 6.5) * 0.02
			p.tail_wag = sin(t * 9.0) * 0.6
			p.ear_lift = 0.2
		"cheer":
			var hop := absf(sin(t * TAU * 1.6))
			p.rig_y = hop * 0.11
			p.squash = 1.0 - pow(1.0 - hop, 4.0) * 0.12 + hop * 0.05
			p.arm_l = Vector3(-0.25, 0, 1.9 + sin(t * TAU * 1.6) * 0.3)
			p.arm_r = Vector3(-0.25, 0, 1.9 - sin(t * TAU * 1.6) * 0.3)
			p.foot_l = Vector3(0, hop * 0.03, 0)
			p.foot_r = Vector3(0, hop * 0.03, 0)
			p.head = Vector3(-0.15, sin(t * 4.0) * 0.1, sin(t * 5.0) * 0.12)
			p.happy = true
			p.mouth = 1
			p.ear_lift = 0.35
			p.tail_wag = sin(t * 14.0) * 0.7
			p.bulb_pulse = 1.6
		"jump":
			var anticip := 0.2
			var air := 0.42
			if t < anticip:
				var a := _smooth(t / anticip)
				p.squash = 1.0 - a * 0.2
				p.rig_y = -a * 0.02
				p.arm_l = Vector3(0.6 * a, 0, 0.3)
				p.arm_r = Vector3(0.6 * a, 0, 0.3)
				p.head.x = 0.12 * a
				p.ear_lift = -0.2 * a
			elif t < anticip + air:
				var k := (t - anticip) / air
				p.rig_y = 4.0 * k * (1.0 - k) * 0.34
				p.squash = 1.0 + 0.16 * (1.0 - k) * (1.0 - k) - 0.04 * k
				p.arm_l = Vector3(-0.3, 0, 1.95)
				p.arm_r = Vector3(-0.3, 0, 1.95)
				p.foot_l = Vector3(0, 0.04, -0.02)
				p.foot_r = Vector3(0, 0.04, -0.02)
				p.foot_pitch = Vector2(0.4, 0.4)
				p.head.x = -0.2
				p.happy = true
				p.mouth = 1
				p.ear_lift = -0.3
			else:
				var l := (t - anticip - air) / (length - anticip - air)
				var sq := sin(clampf(l * 1.6, 0.0, 1.0) * PI)
				p.squash = 1.0 - sq * 0.18
				p.arm_l = Vector3(0.0, 0, 0.9 * (1.0 - l) + 0.15)
				p.arm_r = Vector3(0.0, 0, 0.9 * (1.0 - l) + 0.15)
				p.head.x = 0.1 * sq
				p.happy = l < 0.6
				p.mouth = 1 if l < 0.6 else 0
				if l < 0.05:
					_kick = maxf(_kick, 0.6)
		"surprise":
			var pop := _ease_out_back(clampf(t / 0.22, 0.0, 1.0))
			var settle := _smooth((t - 0.6) / 0.5)
			var hop := sin(clampf(t / 0.3, 0.0, 1.0) * PI)
			p.rig_y = hop * 0.07
			p.squash = 1.0 + hop * 0.1 - settle * 0.0
			p.arm_l = Vector3(-0.35, 0, lerpf(1.25 * pop, 0.35, settle))
			p.arm_r = Vector3(-0.35, 0, lerpf(1.25 * pop, 0.35, settle))
			p.head = Vector3(lerpf(-0.22, -0.05, settle), p.head.y, 0.0)
			p.hips_pitch = lerpf(-0.12, 0.0, settle)
			p.eye_scale = lerpf(1.3, 1.08, settle)
			p.mouth = 2
			p.ear_lift = lerpf(0.55, 0.1, settle)
			p.ear_spread = lerpf(0.3, 0.0, settle)
			p.tail_lift = 0.5
			p.bulb_pulse = 2.0 - settle
		"nod":
			var n := sin(u * TAU * 2.0) * (1.0 - u)
			p.head = Vector3(0.25 * n + 0.05, p.head.y, 0.05)
			p.squash = 1.0 - absf(n) * 0.03
			p.mouth = 0
		"spin":
			var k := _smooth(u)
			p.hips_yaw = k * TAU
			p.rig_y = sin(u * PI) * 0.12
			p.arm_l = Vector3(0, 0, 1.4 * sin(u * PI))
			p.arm_r = Vector3(0, 0, 1.4 * sin(u * PI))
			p.happy = true
			p.mouth = 1
			p.ear_lift = 0.4 * sin(u * PI)
		"hop":
			var a := 0.12
			var air := 0.28
			if t < a:
				var k := _smooth(t / a)
				p.squash = 1.0 - 0.12 * k
				p.arm_l = p.arm_l.lerp(Vector3(0.3, 0, 0.1), k)
				p.arm_r = p.arm_r.lerp(Vector3(0.3, 0, 0.1), k)
				p.head.x += 0.06 * k
			elif t < a + air:
				var k := (t - a) / air
				p.rig_y = 4.0 * k * (1.0 - k) * 0.11
				p.squash = 1.0 + 0.1 * (1.0 - k) * (1.0 - k)
				p.arm_l = Vector3(-0.2, 0, 0.75)
				p.arm_r = Vector3(-0.2, 0, 0.75)
				p.foot_l = Vector3(0, 0.02, -0.01)
				p.foot_r = Vector3(0, 0.02, -0.01)
				p.foot_pitch = Vector2(0.3, 0.3)
				p.head.x -= 0.08
				p.happy = true
				p.mouth = 1
			else:
				var l := (t - a - air) / maxf(length - a - air, 0.01)
				p.squash = 1.0 - _bump(l * 1.8) * 0.1
				p.happy = l < 0.5
				p.mouth = 1 if l < 0.5 else 0
				if l < 0.1:
					_kick = maxf(_kick, 0.35)
		"clap":
			var env := _smooth(t / 0.2)
			var cyc := fmod(t, 0.34) / 0.34
			var hit := pow(1.0 - absf(cyc * 2.0 - 1.0), 2.5)
			var raise := lerpf(0.4, -1.0, hit)
			p.arm_l = p.arm_l.lerp(Vector3(-1.3 + 0.1 * hit, 0.0, raise), env)
			p.arm_r = p.arm_r.lerp(Vector3(-1.3 + 0.1 * hit, 0.0, raise), env)
			p.squash = 1.0 + hit * 0.025
			p.rig_y = absf(sin(t * TAU * 1.47)) * 0.03
			p.head = Vector3(-0.1, p.head.y, sin(t * 3.0) * 0.1)
			p.happy = true
			p.mouth = 1
			p.ear_lift = 0.25
			p.tail_wag = sin(t * 12.0) * 0.6
			p.bulb_pulse = 1.2 + hit * 0.6
		"celebrate":
			var a := 0.28
			var air := 0.62
			var land := 0.22
			if t < a:
				var k := _smooth(t / a)
				p.squash = 1.0 - 0.22 * k
				p.rig_y = -0.02 * k
				p.arm_l = Vector3(0.7 * k, 0, 0.15)
				p.arm_r = Vector3(0.7 * k, 0, 0.15)
				p.head.x = 0.15 * k
				p.ear_lift = -0.3 * k
				p.eye_squash = 1.0 - 0.3 * k
			elif t < a + air:
				var k := (t - a) / air
				p.rig_y = 4.0 * k * (1.0 - k) * 0.45
				p.squash = 1.0 + 0.18 * (1.0 - k) * (1.0 - k) - 0.05 * k
				p.hips_yaw = _smooth(k) * TAU
				p.arm_l = Vector3(-0.2, 0, 2.3)
				p.arm_r = Vector3(-0.2, 0, 2.3)
				p.foot_l = Vector3(0, 0.05, -0.03)
				p.foot_r = Vector3(0, 0.05, -0.03)
				p.foot_pitch = Vector2(0.5, 0.5)
				p.head.x = -0.2
				p.happy = true
				p.mouth = 1
				p.ear_lift = -0.35
				p.bulb_pulse = 2.2
			elif t < a + air + land:
				var l := (t - a - air) / land
				p.squash = 1.0 - _bump(l) * 0.2
				p.arm_l = Vector3(-0.2, 0, lerpf(2.3, 1.2, l))
				p.arm_r = Vector3(-0.2, 0, lerpf(2.3, 1.2, l))
				p.happy = true
				p.mouth = 1
				p.bulb_pulse = 2.0
				if l < 0.15:
					_kick = maxf(_kick, 0.8)
			else:
				var r := t - (a + air + land)
				var ph := sin(r * TAU * 1.8)
				var hop := absf(ph)
				p.rig_y = hop * 0.05
				p.squash = 1.0 - pow(1.0 - hop, 4.0) * 0.08
				p.arm_l = Vector3(-0.4, 0, 1.6 + ph * 0.6)
				p.arm_r = Vector3(-0.4, 0, 1.6 - ph * 0.6)
				p.head = Vector3(-0.12, p.head.y, sin(r * 8.0) * 0.12)
				p.happy = true
				p.mouth = 1
				p.ear_lift = 0.35
				p.tail_wag = sin(r * 15.0) * 0.7
				p.bulb_pulse = 1.8
		"startled":
			var pop := _ease_out_back(clampf(t / 0.14, 0.0, 1.0))
			var settle := _smooth((t - 0.55) / 0.9)
			var hop := _bump(t / 0.32)
			var cover := _smooth((t - 0.32) / 0.22) * (1.0 - settle)
			p.rig_y = hop * 0.13
			p.rig_z = -0.12 * pop * (1.0 - settle)
			p.squash = 1.0 + hop * 0.14 - cover * 0.05
			p.hips_pitch = -0.18 * (1.0 - settle)
			var flail := Vector3(-0.6 + sin(t * 30.0) * 0.25, 0.0, 1.7 * pop)
			var paws := Vector3(-1.9, 0.0, -0.75)   # paws to the mouth
			p.arm_l = flail.lerp(paws, cover).lerp(Vector3(-0.2, 0, 0.3), settle)
			flail.x = -0.6 + sin(t * 30.0 + 1.7) * 0.25
			p.arm_r = flail.lerp(paws, cover).lerp(Vector3(-0.2, 0, 0.3), settle)
			p.head = Vector3(lerpf(-0.25, 0.0, settle) + cover * 0.12, p.head.y, 0.0)
			p.roll += sin(t * 42.0) * 0.025 * _bump((t - 0.3) / 1.0)
			p.eye_scale = lerpf(1.4, 1.1, settle)
			p.mouth = 2
			p.mouth_size = lerpf(1.35, 1.0, settle)
			p.ear_lift = lerpf(0.75, 0.1, settle)
			p.ear_spread = lerpf(0.45, 0.0, settle)
			p.tail_lift = 0.6 * (1.0 - settle)
			p.bulb_pulse = 2.2 - settle
		"point":
			var wind := _smooth(t / 0.18)
			var thrust := _ease_out_back(clampf((t - 0.18) / 0.24, 0.0, 1.0))
			p.arm_r = Vector3(lerpf(0.35 * wind, -1.45, thrust) + sin(t * 9.0) * 0.04 * thrust, 0.0,
				lerpf(0.2, 0.95, thrust))
			p.arm_l = Vector3(0.25, 0.0, 0.6)
			p.head.y -= 0.35 * thrust
			p.head.x -= 0.06 * thrust
			p.hips_yaw -= 0.15 * thrust
			p.lean += 0.06 * thrust
			p.eye_scale = 1.0 + 0.12 * thrust
			p.eye_off = Vector2(-0.8 * thrust, 0.2)
			p.mouth = 1
			p.ear_lift = 0.25 * thrust
			p.tail_wag = sin(t * 10.0) * 0.4
			p.bulb_pulse = 1.0 + 0.6 * thrust
		"salute":
			var up := _ease_out_back(clampf((t - 0.05) / 0.25, 0.0, 1.0))
			# stubby arms cannot reach the brow: the paw snaps up beside the temple
			# (a raised arm needs + pitch to come forward)
			p.arm_r = Vector3(lerpf(p.arm_r.x, 0.6, up), 0.0, lerpf(0.12, 2.25, up))
			p.arm_l = Vector3(0.05, 0.0, 0.06)
			p.squash = 1.0 + 0.045 * up
			p.hips_pitch = -0.08 * up
			p.head.x = -0.08 * up
			p.mouth = 0
			p.eye_squash = 1.0 - 0.15 * up
			p.ear_lift = 0.22 * up
			p.tail_lift = 0.3 * up
			p.tail_wag = 0.0
			if t > 0.22 and t < 0.27:
				_kick = maxf(_kick, 0.3)
		"bow":
			var down := _smooth((t - 0.1) / 0.35)
			var back := _smooth((t - 0.95) / 0.35)
			var b := down * (1.0 - back)
			p.hips_pitch = 0.55 * b
			p.head.x = 0.25 * b
			p.lean += 0.05 * b
			p.arm_l = Vector3(-0.5 * b, 0.0, 0.08 - 0.25 * b)
			p.arm_r = Vector3(-0.5 * b, 0.0, 0.08 - 0.25 * b)
			p.happy = b > 0.5
			p.mouth = 0
			p.tail_lift = 0.4 * b
		"shrug":
			var s := _smooth(t / 0.25) * _smooth((length - t) / 0.4)
			p.arm_l = Vector3(-0.55 * s, 0.0, 0.12 + 0.8 * s)
			p.arm_r = Vector3(-0.55 * s, 0.0, 0.12 + 0.8 * s)
			p.hips_y += 0.012 * s
			p.head.z += 0.22 * s
			p.head.x -= 0.04 * s
			p.lid = 0.45 * s
			p.mouth = 2
			p.mouth_size = 0.6
			p.ear_lift = 0.25 * s * (1.0 - u) - 0.15 * s * u
			p.ear_spread = 0.15 * s
		"laugh":
			var env := _smooth(t / 0.15) * _smooth((length - t) / 0.5)
			var sh := sin(t * TAU * 5.0)
			var fold := _smooth((t - 0.9) / 0.4)
			p.squash = 1.0 + sh * 0.035 * env
			p.rig_y = absf(sh) * 0.012 * env
			p.hips_pitch = lerpf(-0.1, 0.12, fold) * env
			p.head = Vector3((-0.18 + 0.2 * fold) * env + sh * 0.04 * env, p.head.y, sin(t * 3.0) * 0.12 * env)
			p.arm_l = Vector3(-0.75 + sh * 0.05, 0.0, -0.18)
			p.arm_r = Vector3(-0.75 - sh * 0.05, 0.0, -0.18)
			p.happy = true
			p.mouth = 1
			p.mouth_size = 1.15 + sh * 0.1
			p.ear_lift = 0.2 + sh * 0.1
			p.tail_wag = sin(t * 16.0) * 0.6
			p.bulb_pulse = 1.6 + sh * 0.3
		"sigh":
			var inh := _smooth(t / 0.7)
			var exh := _smooth((t - 0.7) / 0.6)
			var rec := _smooth((t - 1.6) / 0.6)
			var lift := inh * (1.0 - exh)
			var slump := exh * (1.0 - rec)
			p.squash = 1.0 + 0.05 * lift - 0.06 * slump
			p.head.x += -0.12 * lift + 0.3 * slump
			p.hips_pitch = 0.1 * slump
			p.ear_lift = 0.15 * lift - 0.5 * slump
			p.arm_l = Vector3(0.1 * slump, 0.0, 0.12 + 0.12 * lift - 0.08 * slump)
			p.arm_r = Vector3(0.1 * slump, 0.0, 0.12 + 0.12 * lift - 0.08 * slump)
			p.lid = 0.25 * lift + 0.55 * slump
			p.lid_tilt = 0.45 * slump
			p.mouth = 2 if t > 0.7 and t < 1.4 else (3 if slump > 0.3 else 0)
			p.mouth_size = 0.6
			p.tail_lift = -0.4 * slump
			p.bulb_pulse = 1.0 - 0.5 * slump
		"shake_head":
			var env := _smooth(t / 0.1) * (1.0 - u)
			var sh := sin(t * TAU * 3.2) * 0.38 * env
			p.head.y += sh
			p.hips_yaw += sh * 0.1
			p.ear_spread = -sh * 0.4
			p.eye_close = 0.85 * _smooth(t / 0.1) * _smooth((length - t) / 0.25)
			p.mouth = 3
			p.mouth_size = 0.8
		"yawn":
			var up := _smooth(t / 0.7)
			var down := _smooth((t - 1.7) / 0.6)
			var y := up * (1.0 - down)
			var trem := sin(t * 28.0) * 0.012 * y
			p.squash = 1.0 + 0.08 * y + trem
			p.hips_pitch = -0.1 * y
			p.lean -= 0.04 * y
			p.head.x = -0.28 * y
			p.arm_l = Vector3(lerpf(p.arm_l.x, 0.3, y), 0, lerpf(p.arm_l.z, 2.35, y))
			p.arm_r = Vector3(lerpf(p.arm_r.x, 0.3, y), 0, lerpf(p.arm_r.z, 2.35, y))
			p.mouth = 2 if y > 0.15 else 0
			p.mouth_size = 1.0 + 0.9 * y
			p.eye_close = y
			p.ear_lift = -0.35 * y
			p.ear_spread = 0.25 * y
			p.bulb_pulse = 0.5 + 0.5 * (1.0 - y)
			if t > 2.0:
				# smack the lips
				p.mouth_size = 1.0 + sin((t - 2.0) * 30.0) * 0.15 * (1.0 - _smooth((t - 2.0) / 0.5))
		"stretch":
			var s := _smooth(t / 0.45) * _smooth((length - t) / 0.5)
			var side := sin(clampf((t - 0.4) / 1.3, 0.0, 1.0) * TAU)
			p.arm_l = p.arm_l.lerp(Vector3(-2.85, 0.0, 0.35), s)
			p.arm_r = p.arm_r.lerp(Vector3(-2.85, 0.0, 0.35), s)
			p.rig_y += 0.015 * s
			p.roll += side * 0.14 * s
			p.hips_roll += side * 0.08 * s
			p.squash = 1.0 + 0.06 * s
			p.happy = s > 0.6
			p.mouth = 2 if s > 0.6 else 0
			p.mouth_size = 0.7
			p.ear_lift = -0.2 * s


## Face overlay (set_expression), weight w.
func _pose_expression(p: Pose, w: float) -> void:
	var on := w >= 0.5
	match _expr:
		"happy":
			p.eye_squash = lerpf(p.eye_squash, 0.72, w)
			p.ear_lift += 0.12 * w
			p.tail_wag += sin(_t * 9.0) * 0.3 * w
			if on:
				p.mouth = 0
				p.happy = false
		"joy":
			p.ear_lift += 0.25 * w
			p.tail_wag += sin(_t * 12.0) * 0.45 * w
			p.bulb_pulse += 0.4 * w
			if on:
				p.happy = true
				p.mouth = 1
		"content":
			if on:
				p.happy = true
				p.mouth = 0
		"sad":
			p.lid = lerpf(p.lid, 0.38, w)
			p.lid_tilt = lerpf(p.lid_tilt, 0.5, w)
			p.ear_lift -= 0.45 * w
			p.head.x += 0.12 * w
			p.tail_lift -= 0.4 * w
			p.eye_scale += 0.05 * w
			p.bulb_pulse *= 1.0 - 0.4 * w
			if on:
				p.mouth = 3
				p.happy = false
		"surprised":
			p.eye_scale += 0.25 * w
			p.ear_lift += 0.4 * w
			p.lid = lerpf(p.lid, 0.0, w)
			if on:
				p.mouth = 2
				p.happy = false
		"sleepy":
			p.lid = lerpf(p.lid, 0.62, w)
			p.ear_lift -= 0.25 * w
			p.head.x += 0.06 * w
			p.bulb_pulse *= 1.0 - 0.4 * w
			if on:
				p.mouth = 0
				p.happy = false
		"grumpy":
			p.lid = lerpf(p.lid, 0.4, w)
			p.lid_tilt = lerpf(p.lid_tilt, -0.5, w)
			p.ear_lift -= 0.15 * w
			p.mouth_size = lerpf(p.mouth_size, 0.8, w)
			if on:
				p.mouth = 3
				p.happy = false
		"worried":
			p.lid = lerpf(p.lid, 0.15, w)
			p.lid_tilt = lerpf(p.lid_tilt, 0.55, w)
			p.ear_lift -= 0.2 * w
			p.eye_scale += 0.06 * w
			p.mouth_size = lerpf(p.mouth_size, 0.55, w)
			if on:
				p.mouth = 2
				p.happy = false


func _apply_look(p: Pose, dt: float) -> void:
	_glance = _glance.lerp(_glance_target, 1.0 - exp(-4.0 * dt))
	var want := _glance
	if look_weight > 0.0 and is_inside_tree():
		var local := global_transform.affine_inverse() * look_target
		var from := Vector3(0, 0.66, 0)
		var d := local - from
		var yaw := atan2(d.x, d.z)
		var pitch := -atan2(d.y, Vector2(d.x, d.z).length())
		var target := Vector2(clampf(yaw, -1.2, 1.2), clampf(pitch, -0.55, 0.35))
		want = want.lerp(target, look_weight)
	# the head gets there first, the body follows a moment later
	_look_cur = _look_cur.lerp(want, 1.0 - exp(-7.0 * dt))
	_look_body = _look_body.lerp(want, 1.0 - exp(-3.0 * dt))
	p.head.y += _look_cur.x * 0.75
	p.hips_yaw += _look_body.x * 0.25
	p.head.x += _look_cur.y * 0.8
	p.hips_pitch += _look_body.y * 0.15


func _apply(p: Pose, dt: float) -> void:
	# whole-body squash & stretch from the feet; the lean rides a spring (overshoot on stops)
	_sp_lean = _spring(_sp_lean, p.lean, lean_spring_hz, 0.28, dt)
	var sq := maxf(p.squash, 0.5)
	var side := 1.0 / sqrt(sq)
	rig.transform = Transform3D(Basis.from_euler(Vector3(_sp_lean.x, 0, p.roll)).scaled(Vector3(side, sq, side)),
		Vector3(0, p.rig_y, p.rig_z))
	_pose_node(hips, Vector3(p.hips_pitch, p.hips_yaw, p.hips_roll), Vector3(p.hips_x, p.hips_y, 0))
	_pose_node(neck, p.head, Vector3(0, p.head_y, 0))
	_pose_node(foot_l, Vector3(p.foot_pitch.x, 0, 0), p.foot_l)
	_pose_node(foot_r, Vector3(p.foot_pitch.y, 0, 0), p.foot_r)
	_pose_node(arm_l, Vector3(p.arm_l.x, p.arm_l.y, p.arm_l.z), Vector3.ZERO)
	_pose_node(arm_r, Vector3(p.arm_r.x, -p.arm_r.y, -p.arm_r.z), Vector3.ZERO)
	# shadow follows jumps: smaller and lighter in the air
	var air := clampf(p.rig_y / 0.35, 0.0, 1.0)
	shadow.scale = Vector3.ONE * (1.0 - air * 0.35)

	# secondary motion: springs driven by how the head moves
	if dt > 0.0:
		var np := neck.global_position
		var v := (np - _last_neck) / dt
		_last_neck = np
		var s := maxf(global_basis.get_scale().x, 0.01)
		_neck_vel = (global_basis.orthonormalized().inverse() * v) / s
		_neck_vel = _neck_vel.limit_length(4.0)
		_neck_vel_s = _neck_vel_s.lerp(_neck_vel, 1.0 - exp(-12.0 * dt))
	var vup := _neck_vel_s.y
	var vfwd := _neck_vel_s.z
	var kick := _kick
	_kick = maxf(0.0, _kick - dt * 4.0)
	var ear_t := p.ear_lift + clampf(-vup * 0.9, -0.5, 0.6) + clampf(vfwd * 0.5, 0.0, 0.5) + kick * 0.6
	_sp_ear_l = _spring(_sp_ear_l, ear_t + sin(_t * 1.9) * 0.03, 2.4, 0.22, dt)
	_sp_ear_r = _spring(_sp_ear_r, ear_t + sin(_t * 1.9 + 0.9) * 0.03, 2.2, 0.2, dt)
	_sp_ear_spread = _spring(_sp_ear_spread, p.ear_spread + kick * 0.25, 3.0, 0.25, dt)
	var el: Transform3D = _rest[ear_l]
	var er: Transform3D = _rest[ear_r]
	ear_l.transform = Transform3D(Basis.from_euler(Vector3(_sp_ear_l.x, 0, _sp_ear_spread.x - _sp_ear_l.x * 0.25)), el.origin)
	ear_r.transform = Transform3D(Basis.from_euler(Vector3(_sp_ear_r.x, 0, -_sp_ear_spread.x + _sp_ear_r.x * 0.25)), er.origin)
	_sp_ant_x = _spring(_sp_ant_x, clampf(-vfwd * 0.35 + vup * 0.4, -0.7, 0.7) - kick * 0.4, 3.2, 0.16, dt)
	_sp_ant_z = _spring(_sp_ant_z, clampf(_neck_vel_s.x * 0.4 + _yaw_rate * 0.05, -0.6, 0.6) + p.head.z * -0.6,
		3.0, 0.16, dt)
	var ar: Transform3D = _rest[antenna]
	antenna.transform = Transform3D(Basis.from_euler(Vector3(_sp_ant_x.x, 0, _sp_ant_z.x)), ar.origin)
	var bpulse := p.bulb_pulse
	var bs := 1.0 + (bpulse - 1.0) * 0.12 + sin(_t * 5.0) * 0.03
	var br: Transform3D = _rest[bulb]
	bulb.transform = Transform3D(Basis.from_euler(Vector3(0, 0, sin(_t * 1.3) * 0.2)).scaled(Vector3.ONE * bs), br.origin)
	var glow := 1.1 + bpulse * 0.9
	if absf(glow - _last_glow) > 0.015:
		_last_glow = glow
		for m in _bulb_meshes:
			m.set_instance_shader_parameter("glow_energy", glow)
	_sp_tail = _spring(_sp_tail, p.tail_wag, 2.8, 0.3, dt)
	var tr: Transform3D = _rest[tail]
	tail.transform = Transform3D(Basis.from_euler(Vector3(-p.tail_lift - clampf(vfwd * 0.3, 0.0, 0.4), _sp_tail.x, _sp_tail.x * 0.3)), tr.origin)
	if scarf.visible:
		_sp_scarf = _spring(_sp_scarf, clampf(vfwd * 0.9, 0.0, 1.2) + clampf(-vup * 0.6, -0.4, 0.4) + sin(_t * 3.0) * 0.08, 2.0, 0.25, dt)
		var stf: Transform3D = _rest[scarf_tail]
		scarf_tail.transform = Transform3D(Basis.from_euler(Vector3(-_sp_scarf.x, sin(_t * 2.0) * 0.2, 0)), stf.origin)

	# face: blink, closed / wide / squinting / happy eyes, eye darts, lids, mouth
	var blink := 0.0
	if _blink_t >= 0.0:
		blink = sin(clampf(_blink_t / 0.16, 0.0, 1.0) * PI)
	var closed := maxf(blink, clampf(p.eye_close, 0.0, 1.0))
	var es := p.eye_scale
	var ey := es * p.eye_squash * (1.0 - closed * 0.92)
	if eye_darts and _near:
		_dart = _dart.lerp(_dart_target, 1.0 - exp(-28.0 * dt))
	else:
		_dart = Vector2.ZERO
	var look_shift := Vector3(_look_cur.x * 0.008 + (p.eye_off.x + _dart.x * 0.6) * 0.006,
		-_look_cur.y * 0.008 + (p.eye_off.y + _dart.y * 0.6) * 0.005, 0)
	var lid_amt := clampf(p.lid, 0.0, 1.0)
	var show_lid := lid_amt > 0.03 and not p.happy and p.eye_close < 0.6
	_pose_eye(eye_l, lid_l, es, ey, look_shift, lid_amt, -p.lid_tilt, show_lid)
	_pose_eye(eye_r, lid_r, es, ey, look_shift, lid_amt, p.lid_tilt, show_lid)
	var hp := 1 if p.happy else 0
	if hp != _shown_happy:
		_shown_happy = hp
		eye_l.visible = not p.happy
		eye_r.visible = not p.happy
		happy_l.visible = p.happy
		happy_r.visible = p.happy
	if p.mouth != _shown_mouth:
		_shown_mouth = p.mouth
		mouth_smile.visible = p.mouth == 0 or p.mouth == 3
		mouth_open.visible = p.mouth == 1
		mouth_oh.visible = p.mouth == 2
		var sr: Transform3D = _rest[mouth_smile]
		# frown: the smile upside down
		mouth_smile.transform = Transform3D(Basis(Vector3.BACK, PI), sr.origin) if p.mouth == 3 else sr
	var mr: Transform3D = _rest[mouth]
	var ms := clampf(p.mouth_size, 0.2, 2.5)
	mouth.transform = Transform3D(Basis.from_scale(Vector3(ms, ms, 1.0)), mr.origin)
	if p.item != _shown_item:
		_shown_item = p.item
		for k in items:
			(items[k] as Node3D).visible = (k == p.item)

	# emote bubble: pop in with overshoot, float, shrink away
	if _emote_t >= 0.0:
		var a := clampf(_emote_t / 0.28, 0.0, 1.0)
		var out := clampf((_emote_len - _emote_t) / 0.2, 0.0, 1.0)
		var sc := _ease_out_back(a) * _smooth(out)
		emote_sprite.scale = Vector3.ONE * maxf(sc, 0.01)
		emote_sprite.position = Vector3(0, 1.32 + p.rig_y + _emote_t * 0.05 + sin(_t * 4.0) * 0.015, 0)


func _pose_eye(e: Node3D, lid: Node3D, es: float, ey: float, shift: Vector3, lid_amt: float, tilt: float,
		show_lid: bool) -> void:
	var rest: Transform3D = _rest[e]
	e.transform = Transform3D(Basis.from_scale(Vector3(es, maxf(ey, 0.05), 1.0)), rest.origin + shift)
	lid.visible = show_lid
	if show_lid:
		var lrest: Transform3D = _rest[lid]
		lid.transform = Transform3D(Basis.from_euler(Vector3(0, 0, tilt)) * Basis.from_scale(Vector3(1.0, maxf(lid_amt, 0.01), 1.0)),
			lrest.origin)


func _pose_node(n: Node3D, euler: Vector3, offset: Vector3) -> void:
	var r: Transform3D = _rest[n]
	n.transform = Transform3D(Basis.from_euler(euler), r.origin + offset)

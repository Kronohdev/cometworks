theme_override_constants/separation = 12

[node name="Header" type="HBoxContainer" parent="Panel/Margin/VBox"]
layout_mode = 2
theme_override_constants/separation = 14

[node name="Icon" type="TextureRect" parent="Panel/Margin/VBox/Header"]

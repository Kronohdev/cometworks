{
  "version": 1,
  "_doc": "Mission operations (GDD sections 7 and 14), read by src/tycoon/ops/mission_ops.gd. Data in Gb. Each week in operations: generated = gen_per_week * modifiers; stored = min(storage, stored + generated) (the excess is LOST); downlinked = min(possible, stored) with possible = base_downlink * network.gain[antenna level] * target.link * target.contact[antenna level] * spacecraft antenna; science += downlinked * value * scientist bonus; research points += science * research_share.",
  "base_downlink": 40.0,
  "research_share": 0.5,
  "scientist_bonus_each": 0.05,
  "scientist_bonus_max": 5,
  "decision_timeout_weeks": 3,

[node name="CwTransition" type="Node" parent="."]
script = ExtResource("cwm_screen")
backdrop = NodePath("../Backdrop")
panel = NodePath("../Frame")

[node name="CwCascade" type="Node" parent="."]
script = ExtResource("cwm_stagger")
target = NodePath("../Frame/VBox")
offset = Vector2(0, 10)
delay = 0.08
step = 0.04
seconds = 0.3
animate_added = false
curve = 1

[node name="CwRows" type="Node" parent="."]
script = ExtResource("cwm_stagger")
target = NodePath("../Frame/VBox/MissionsPage/Scroll/Rows")
offset = Vector2(0, 8)
delay = 0.16
step = 0.03
seconds = 0.26
max_delay = 0.45

[node name="CwCards" type="Node" parent="."]
script = ExtResource("cwm_stagger")
target = NodePath("../Frame/VBox/CardsPage/Scroll/Grid")
offset = Vector2(0, 8)
delay = 0.16
step = 0.03
seconds = 0.26
max_delay = 0.45
on_visible = true
from_scale = Vector2(0.96, 0.96)

[node name="CwButtons" type="Node" parent="."]
script = ExtResource("cwm_btn")
scope = 1
lift = Vector2(0, -1)
hover_scale = Vector2(1.02, 1.02)
glow = 1.08
sweep_on_focus = true

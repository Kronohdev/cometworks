[node name="Pilot" type="Button" parent="Panel/Margin/VBox/Choices/PilotCard/Margin/VBox"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 46)
layout_mode = 2
focus_mode = 0
theme_type_variation = &"CwPrimary"
text = "TY_HG_CHOICE_PILOT_GO"

[node name="AutoCard" type="PanelContainer" parent="Panel/Margin/VBox/Choices"]
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"CwBox"

[node name="Margin" type="MarginContainer" parent="Panel/Margin/VBox/Choices/AutoCard"]
layout_mode = 2
theme_override_constants/margin_left = 16
theme_override_constants/margin_top = 14
theme_override_constants/margin_right = 16
theme_override_constants/margin_bottom = 14

[node name="VBox" type="VBoxContainer" parent="Panel/Margin/VBox/Choices/AutoCard/Margin"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="Head" type="HBoxContainer" parent="Panel/Margin/VBox/Choices/AutoCard/Margin/VBox"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="Icon" type="TextureRect" parent="Panel/Margin/VBox/Choices/AutoCard/Margin/VBox/Head"]
custom_minimum_size = Vector2(44, 44)
layout_mode = 2
mouse_filter = 2
texture = ExtResource("3_auto")
expand_mode = 1
stretch_mode = 5

[node name="Name" type="Label" parent="Panel/Margin/VBox/Choices/AutoCard/Margin/VBox/Head"]
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"CwTitle"
theme_override_font_sizes/font_size = 21
text = "TY_HG_CHOICE_AUTO"
autowrap_mode = 3

[node name="Desc" type="Label" parent="Panel/Margin/VBox/Choices/AutoCard/Margin/VBox"]
custom_minimum_size = Vector2(0, 64)
layout_mode = 2

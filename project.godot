; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Margin"
run/main_scene="res://scenes/menu/main_menu.tscn"
config/features=PackedStringArray("4.6", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

CwAudio="*res://scenes/audio/cw_sfx.tscn"
CwDev="*res://scenes/dev/dev_menu.tscn"

[cometworks]

dev/enabled=false

[debug]

file_logging/max_log_files=30

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[dotnet]

project/assembly_name="Margin"

[internationalization]

locale/translations=PackedStringArray("res://i18n/strings.en.translation", "res://i18n/strings.pt.translation", "res://i18n/solar_system_strings.en.translation", "res://i18n/solar_system_strings.pt.translation", "res://i18n/surface_strings.en.translation", "res://i18n/surface_strings.pt.translation", "res://i18n/crew_strings.en.translation", "res://i18n/crew_strings.pt.translation", "res://i18n/flight_strings.en.translation", "res://i18n/flight_strings.pt.translation", "res://i18n/tycoon_strings.en.translation", "res://i18n/tycoon_strings.pt.translation", "res://i18n/menu_strings.en.translation", "res://i18n/menu_strings.pt.translation", "res://i18n/tycoon_crew_strings.en.translation", "res://i18n/tycoon_crew_strings.pt.translation", "res://i18n/tycoon_project_strings.en.translation", "res://i18n/tycoon_project_strings.pt.translation", "res://i18n/tycoon_ops_strings.en.translation", "res://i18n/tycoon_ops_strings.pt.translation", "res://i18n/tycoon_agency_strings.en.translation", "res://i18n/tycoon_agency_strings.pt.translation", "res://i18n/tycoon_race_strings.en.translation", "res://i18n/tycoon_race_strings.pt.translation", "res://i18n/tycoon_leader_strings.en.translation", "res://i18n/tycoon_leader_strings.pt.translation", "res://i18n/tycoon_launch_strings.en.translation", "res://i18n/tycoon_launch_strings.pt.translation", "res://i18n/tycoon_rocket_strings.en.translation", "res://i18n/tycoon_rocket_strings.pt.translation", "res://i18n/cutscene_strings.en.translation", "res://i18n/cutscene_strings.pt.translation", "res://i18n/tycoon_nav_strings.en.translation", "res://i18n/tycoon_nav_strings.pt.translation", "res://i18n/tycoon_integrated_strings.en.translation", "res://i18n/tycoon_integrated_strings.pt.translation", "res://i18n/tycoon_tracking_strings.en.translation", "res://i18n/tycoon_tracking_strings.pt.translation", "res://i18n/tycoon_legend_strings.en.translation", "res://i18n/tycoon_legend_strings.pt.translation", "res://i18n/tycoon_tutorial_strings.en.translation", "res://i18n/tycoon_tutorial_strings.pt.translation", "res://i18n/flight_cw_strings.en.translation", "res://i18n/flight_cw_strings.pt.translation", "res://i18n/fx_strings.en.translation", "res://i18n/fx_strings.pt.translation", "res://i18n/tycoon_talk_strings.en.translation", "res://i18n/tycoon_talk_strings.pt.translation", "res://i18n/story_sign_strings.en.translation", "res://i18n/story_sign_strings.pt.translation", "res://i18n/tycoon_unlock_strings.en.translation", "res://i18n/tycoon_unlock_strings.pt.translation", "res://i18n/rover_strings.en.translation", "res://i18n/rover_strings.pt.translation", "res://i18n/launch_flight_strings.en.translation", "res://i18n/launch_flight_strings.pt.translation", "res://i18n/solar_map_strings.en.translation", "res://i18n/solar_map_strings.pt.translation", "res://i18n/surface_explore_strings.en.translation", "res://i18n/surface_explore_strings.pt.translation", "res://i18n/story_narration_strings.en.translation", "res://i18n/story_narration_strings.pt.translation", "res://i18n/lenda_talk_strings.en.translation", "res://i18n/lenda_talk_strings.pt.translation", "res://i18n/research_tree_strings.en.translation", "res://i18n/research_tree_strings.pt.translation", "res://i18n/bankruptcy_strings.en.translation", "res://i18n/bankruptcy_strings.pt.translation", "res://i18n/conference_strings.en.translation", "res://i18n/conference_strings.pt.translation")

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=1
environment/ssao/quality=1
environment/ssao/half_size=false
environment/ssil/quality=0
anti_aliasing/quality/screen_space_aa=2
lights_and_shadows/positional_shadow/atlas_size=2048

[shader_globals]

cw_toon={
"type": "float",
"value": 1.0
}
cw_toon_bands={
"type": "int",
"value": 3
}
cw_toon_band_soft={
"type": "float",
"value": 0.03
}
cw_toon_band_low={
"type": "float",
"value": 0.1
}
cw_toon_band_high={
"type": "float",
"value": 0.5
}
cw_toon_ramp={
"type": "sampler2D",
"value": "res://shaders/include/cw_toon_ramp.tres"
}
cw_toon_light_scale={
"type": "float",
"value": 0.78
}
cw_shadow_tint={
"type": "color",
"value": Color(0.5, 0.38, 1, 1)
}
cw_shadow_fill={
"type": "float",
"value": 0.12
}
cw_rim_color={
"type": "color",
"value": Color(0.62, 0.74, 1, 1)
}
cw_rim_strength={
"type": "float",
"value": 0.25
}
cw_outline_color={
"type": "color",
"value": Color(0.12, 0.08, 0.2, 1)
}
cw_outline_strength={
"type": "float",
"value": 0.85
}

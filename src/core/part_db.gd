@tool
class_name PartDB
extends RefCounted
## Static access to data/parts.json (generated by tools/parts_catalog.py):
## localized parts, categories and propellants. Loads lazily on first use, so it
## works the same in the game, in the editor and in headless tests.

const DATA_PATH := "res://data/parts.json"
const MODEL_DIR := "res://assets/voxel/parts/"
const JOINTS_PATH := "res://data/part_joints.json"
const G0 := 9.80665

static var size_classes: Dictionary = {}
static var propellants: Dictionary = {}
static var categories: Dictionary = {}
static var parts: Dictionary = {}  # id -> part dictionary
static var part_order: Array[String] = []
static var delta_v_map: Array = []

static var _loaded := false
static var _model_cache: Dictionary = {}


static func _ensure() -> void:
	if _loaded:
		return
	_loaded = true
	var data: Variant = JSON.parse_string(FileAccess.get_file_as_string(DATA_PATH))
	if typeof(data) != TYPE_DICTIONARY:
		push_error("PartDB: could not parse %s" % DATA_PATH)
		return
	size_classes = data["size_classes"]
	propellants = data["propellants"]
	categories = data["categories"]
	delta_v_map = data["delta_v_map"]
	# joint profiles of the models (tools/joint_profiles.py): solid body faces near each stack node
	var joints: Variant = JSON.parse_string(FileAccess.get_file_as_string(JOINTS_PATH)) \
		if FileAccess.file_exists(JOINTS_PATH) else {}
	for p in data["parts"]:
		if typeof(joints) == TYPE_DICTIONARY and joints.has(p["id"]):
			p["joint"] = joints[p["id"]]
		parts[p["id"]] = p
		part_order.append(p["id"])


static func get_part(id: String) -> Dictionary:
	_ensure()
	return parts.get(id, {})


static func category_ids() -> Array[String]:
	_ensure()
	var out: Array[String] = []
	for c in categories:
		out.append(c)
	return out


static func parts_in_category(cat: String) -> Array[String]:
	_ensure()
	var out: Array[String] = []
	for id in part_order:
		if parts[id]["category"] == cat:
			out.append(id)
	return out


## Picks the "en"/"pt" entry of a bilingual dictionary for the current locale.
static func loc(d: Variant) -> String:
	if typeof(d) != TYPE_DICTIONARY:
		return str(d)
	var lang := TranslationServer.get_locale().substr(0, 2)
	return d.get(lang, d.get("en", ""))


static func part_name(id: String) -> String:
	return loc(get_part(id).get("name", id))


static func category_name(cat: String) -> String:
	_ensure()
	return loc(categories.get(cat, cat))


static func model_scene(id: String) -> PackedScene:
	if _model_cache.has(id):
		return _model_cache[id]
	var path := MODEL_DIR + id + ".glb"
	var scene: PackedScene = load(path) if ResourceLoader.exists(path) else null
	_model_cache[id] = scene
	return scene


# ------------------------------------------------------------ part queries
static func is_engine(p: Dictionary) -> bool:
	return p.get("category", "") == "engine"


static func is_stack_decoupler(p: Dictionary) -> bool:
	var id: String = p.get("id", "")
	return id.begins_with("decoupler_") and id != "decoupler_radial"


static func is_radial_decoupler(p: Dictionary) -> bool:
	return p.get("id", "") == "decoupler_radial"


static func is_fairing(p: Dictionary) -> bool:
	return String(p.get("id", "")).begins_with("fairing_")


static func is_command(p: Dictionary) -> bool:
	return p.get("category", "") in ["command", "bus"] or p.get("id", "") == "crew_capsule"


## Propellant carried by the part itself (tanks and solid boosters), in kg.
static func prop_mass(p: Dictionary) -> float:
	if p.get("category", "") == "tank" or p.get("propellant", "") == "solid":
		return float(p.get("prop_mass_kg", 0.0))
	return 0.0


static func wet_mass(p: Dictionary) -> float:
	return float(p.get("mass_kg", 0.0)) + prop_mass(p)

class_name CampusBuilding
extends Node3D
## One campus building (scenes/tycoon/buildings/<kind>.tscn, generated by
## tools/build_campus_buildings.py). The scene holds every look: Era1..Era5, each with
## Level1..Level3 shown cumulatively, plus a Scaffold for construction and walk Spots.
##
## Cutaway: every level model has a "Base" mesh (floor, interior, 1 m wall stubs, yard) and
## cutaway meshes: "CutRoof" (roof and rooftop props), "CutUpper" (upper storeys) and
## "CutPX/NX/PZ/NZ" (the upper walls, by the side they face). When the camera comes
## closer than `cutaway_distance`, roofs and upper storeys fold away and the walls that
## face the camera drop to their stubs, so the decorated interiors show. The pieces fold
## by scaling their height (their origin is at their bottom), so it stays a cheap toggle.

@export var kind := ""
@export_group("Cutaway")
## Open the buildings when the camera is close.
@export var cutaway_enabled := true
## Camera distance (m, to the building centre) under which roofs and front walls fold away.
@export var cutaway_distance := 75.0
## Extra distance before closing again, so the view does not flicker at the threshold.
@export var cutaway_hysteresis := 6.0
## A wall drops when its outward direction points at least this much towards the camera
## (dot product of the horizontal directions; 0 = side-on, 1 = facing the camera).
@export_range(-1.0, 1.0) var wall_facing_threshold := 0.2
## Fold speed (1 / seconds for a full fold).
@export var cutaway_speed := 3.5
@export_group("Pad")
## seconds a pad's rocket takes to glide to its new rollout place when a week passes
@export var rollout_glide := 1.2

var era := 1
var level := 1
var building := false
## pads: the next rocket's rollout, 1 = standing on the pad (set_rocket_progress)
var rocket_progress := 1.0
## pads: the launch sequence keeps the pad's rocket off (hold_rocket)
var rocket_held := false

const ROLLOUT := "res://scenes/tycoon/launch/pad_rollout.tscn"
const DESIGNED_ROCKET := "res://scenes/tycoon/launch/designed_rocket.tscn"
## pads: the design of the rocket on the pad ({} = the era's rocket), set_rocket_design
var rocket_parts: Dictionary = {}
var _designed_era := 0

const _WALL_DIRS := {"CutPX": Vector3.RIGHT, "CutNX": Vector3.LEFT, "CutPZ": Vector3.BACK, "CutNZ": Vector3.FORWARD}

var _open := false
var _rollout: Node3D
var _rollout_tween: Tween
var _rocket_home := {}   # era -> the rocket's authored transform on the pad
## [{node: Node3D, dir: Vector3 (ZERO for roofs and upper storeys), t: float 0 closed .. 1 folded}]
var _cut: Array[Dictionary] = []


func _ready() -> void:
	_collect_cut()


## Shows the look for an era and level. `under_construction`: the scaffold stands on the
## lot (over the previous level, or alone for a new building).
func set_look(p_era: int, p_level: int, under_construction := false) -> void:
	era = clampi(p_era, 1, 5)
	level = clampi(p_level, 0, 3)
	building = under_construction
	for e in range(1, 6):
		var eg := get_node_or_null("Era%d" % e) as Node3D
		if eg == null:
			continue
		eg.visible = e == era and level > 0
		for l in range(1, 4):
			var lg := eg.get_node_or_null("Level%d" % l) as Node3D
			if lg:
				lg.visible = l <= level
	var sc := get_node_or_null("Scaffold") as Node3D
	if sc:
		sc.visible = building
	if kind == "pad":
		if not rocket_parts.is_empty() and _designed_era != era:
			_apply_design()
		_show_rocket(rocket_progress)
	_collect_cut()


## The pad's next rocket after a launch: 0 = just launched (empty pad) .. 1 = standing ready.
## The look is scenes/tycoon/launch/pad_rollout.tscn: its AnimationPlayer "rollout" (0..1 s =
## the progress) keys the crawler and RocketSlot, whose place the era's rocket takes.
## A change while on screen glides there in `rollout_glide` seconds.
func set_rocket_progress(p: float) -> void:
	p = clampf(p, 0.0, 1.0)
	if is_equal_approx(p, rocket_progress):
		return
	var from := rocket_progress
	rocket_progress = p
	if _rollout_tween:
		_rollout_tween.kill()
	if is_inside_tree() and is_visible_in_tree() and p > from and rollout_glide > 0.0:
		_rollout_tween = create_tween()
		_rollout_tween.tween_method(_show_rocket, from, p, rollout_glide)
	else:
		_show_rocket(p)


## The designed rocket the pad shows (E2, RocketDesigner parts; {} = the era's own rocket):
## a DesignedRocket (scenes/tycoon/launch/designed_rocket.tscn) takes the place of the era
## model under Era<n>/Level1/Rocket, so the rollout carries it too (LaunchPads.pad_rocket).
func set_rocket_design(parts: Dictionary) -> void:
	if kind != "pad":
		return
	var same := rocket_parts.is_empty() == parts.is_empty() \
		and (parts.is_empty() or RocketDesigner.same_parts(rocket_parts, parts))
	if same and _designed_era == era:
		return
	rocket_parts = parts.duplicate()
	_apply_design()


func _apply_design() -> void:
	_designed_era = era
	for e in range(1, 6):
		var r := get_node_or_null("Era%d/Level1/Rocket" % e) as Node3D
		if r == null:
			continue
		var m := r.get_node_or_null("Model") as Node3D
		var d := r.get_node_or_null("Designed") as DesignedRocket
		var on := e == era and not rocket_parts.is_empty()
		if m:
			m.visible = not on
		if on:
			if d == null:
				d = (load(DESIGNED_ROCKET) as PackedScene).instantiate() as DesignedRocket
				d.name = "Designed"
				r.add_child(d)
			d.visible = true
			d.build(rocket_parts)
		elif d:
			d.visible = false


## Keeps the pad's rocket (and its rollout) off while the launch sequence flies its own.
func hold_rocket(on: bool) -> void:
	rocket_held = on
	_show_rocket(rocket_progress)


func _show_rocket(p: float) -> void:
	var r := get_node_or_null("Era%d/Level1/Rocket" % era) as Node3D
	if r == null:
		return
	if not _rocket_home.has(era):
		_rocket_home[era] = r.transform
	var home: Transform3D = _rocket_home[era]
	if p >= 1.0 or level <= 0:
		r.transform = home
		r.visible = not rocket_held
		if _rollout:
			_rollout.visible = false
		return
	if _rollout == null:
		var ps := load(ROLLOUT) as PackedScene
		if ps == null:
			r.visible = false
			return
		_rollout = ps.instantiate() as Node3D
		add_child(_rollout)
	_rollout.visible = not rocket_held
	var ap := _rollout.get_node_or_null("AnimationPlayer") as AnimationPlayer
	if ap and ap.has_animation("rollout"):
		ap.play("rollout")
		ap.seek(p * ap.current_animation_length, true)
		ap.pause()
	var slot := _rollout.get_node_or_null("RocketSlot") as Node3D
	r.visible = not rocket_held and slot != null and slot.visible
	if slot:
		r.transform = Transform3D(home.basis, slot.position)


## Walk spots in world space: [{"pos", "door", "action", "yaw"}, plus "via" for interior
## spots: a point just inside the doorway, between the door marker and the spot]. A spot
## belongs to the level in its `level` metadata and only counts once that level is built.
func spots() -> Array[Dictionary]:
	var out: Array[Dictionary] = []
	var sp := get_node_or_null("Spots")
	if sp == null or level <= 0:
		return out
	for m in sp.get_children():
		if m is Marker3D and int(m.get_meta("level", 1)) <= level:
			var d: Vector3 = m.get_meta("door", Vector3.ZERO)
			var spot := {"name": String(m.name), "pos": (m as Marker3D).global_position, "door": global_transform * d,
				"action": String(m.get_meta("action", "idle")), "yaw": (m as Marker3D).global_rotation.y}
			if m.has_meta("via"):
				spot["via"] = global_transform * (m.get_meta("via") as Vector3)
			out.append(spot)
	return out


## True while the cutaway shows the inside (the camera is close): props on the roof hide,
## the ones inside come alive (BuildingFx).
func is_open() -> bool:
	return _open


## Folds the cutaway pieces now (no easing), e.g. for screenshots.
func snap_cutaway() -> void:
	_update_cutaway(1000.0)


func _process(delta: float) -> void:
	_update_cutaway(delta)


func _update_cutaway(delta: float) -> void:
	if _cut.is_empty():
		return
	var cam := get_viewport().get_camera_3d() if is_inside_tree() else null
	var to_cam := Vector3.ZERO
	if cam and cutaway_enabled:
		var centre := global_position + Vector3(0, 3, 0)
		var d := cam.global_position.distance_to(centre)
		if _open:
			_open = d < cutaway_distance + cutaway_hysteresis
		else:
			_open = d < cutaway_distance
		# camera direction in the building's frame, flattened
		to_cam = global_transform.basis.inverse() * (cam.global_position - centre)
		to_cam.y = 0.0
		to_cam = to_cam.normalized()
	else:
		_open = false
	for c in _cut:
		var n := c["node"] as Node3D
		if not is_instance_valid(n):
			continue
		var dir: Vector3 = c["dir"]
		var want := 0.0
		if _open and (dir == Vector3.ZERO or dir.dot(to_cam) > wall_facing_threshold):
			want = 1.0
		var t: float = c["t"]
		if is_equal_approx(t, want):
			continue
		t = move_toward(t, want, delta * cutaway_speed)
		c["t"] = t
		var k := t * t * (3.0 - 2.0 * t)
		n.scale = Vector3(1.0, maxf(0.001, 1.0 - k), 1.0)
		n.visible = t < 0.999


## Finds the cutaway meshes of the levels on show (Era<e>/Level<l>/Model/Cut*).
func _collect_cut() -> void:
	var keep := {}
	for c in _cut:
		keep[c["node"]] = c["t"]
	_cut.clear()
	for e in range(1, 6):
		if e != era:
			continue
		for l in range(1, 4):
			var lg := get_node_or_null("Era%d/Level%d" % [e, l])
			if lg == null or l > maxi(level, 1):
				continue
			for n in lg.find_children("Cut*", "Node3D", true, false):
				var nm := String(n.name)
				var dir: Vector3 = _WALL_DIRS.get(nm, Vector3.ZERO)
				if not keep.has(n):
					(n as Node3D).scale = Vector3.ONE
					(n as Node3D).visible = true
				_cut.append({"node": n, "dir": dir, "t": keep.get(n, 0.0)})

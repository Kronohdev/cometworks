stretch_mode = 5

[node name="Titles" type="VBoxContainer" parent="Panel/Margin/VBox/Header"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 2

[node name="Title" type="Label" parent="Panel/Margin/VBox/Header/Titles"]

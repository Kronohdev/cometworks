@export var eye_darts := true
@export_range(0.0, 3.0, 0.05) var breath_depth := 1.0
## Breaths per second.
@export_range(0.05, 1.5, 0.01) var breath_rate := 0.33
## "zzz" bubbles while the sleep loop plays.
@export var auto_emotes := true

@export_group("Gait")
## Squash, stretch and bounce of the steps.
@export_range(0.0, 3.0, 0.05) var walk_bounce := 1.0
@export_range(0.0, 3.0, 0.05) var arm_swing := 1.0
## Metres per step (model units, before the node scale) when walking / when running.
@export var stride := 0.16
@export var run_stride := 0.27
## Model-unit speed (m/s) where the walk starts turning into a run (x) and is a full run (y).
@export var run_speed := Vector2(1.1, 2.2)

autowrap_mode = 3

[node name="Auto" type="Button" parent="Panel/Margin/VBox/Choices/AutoCard/Margin/VBox"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 46)
layout_mode = 2
focus_mode = 0
theme_type_variation = &"CwSecondary"
text = "TY_HG_CHOICE_AUTO_GO"

[node name="Footer" type="HBoxContainer" parent="Panel/Margin/VBox"]
layout_mode = 2
alignment = 2
theme_override_constants/separation = 10

[node name="Later" type="Button" parent="Panel/Margin/VBox/Footer"]
unique_name_in_owner = true
custom_minimum_size = Vector2(170, 42)
layout_mode = 2
focus_mode = 0
theme_type_variation = &"CwKey"
text = "TY_HG_CHOICE_LATER"

[node name="CwTransition" type="Node" parent="."]
script = ExtResource("cwm_screen")
backdrop = NodePath("../Scrim")
panel = NodePath("../Panel")
overshoot = true
from_scale = Vector2(0.95, 0.95)
in_seconds = 0.3

[node name="CwCascade" type="Node" parent="."]
script = ExtResource("cwm_stagger")
target = NodePath("../Panel/Margin/VBox/Choices")
offset = Vector2(0, 12)
delay = 0.12
step = 0.06
seconds = 0.3
animate_added = false
curve = 1

[node name="CwButtons" type="Node" parent="."]
script = ExtResource("cwm_btn")
scope = 1
lift = Vector2(0, -2)
hover_scale = Vector2(1.02, 1.02)
glow = 1.08
sweep_on_focus = true

theme_type_variation = &"CwBody"
theme_override_font_sizes/font_size = 14
text = "TY_HG_CHOICE_AUTO_DESC"
autowrap_mode = 3

[node name="AutoOdds" type="Label" parent="Panel/Margin/VBox/Choices/AutoCard/Margin/VBox"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"CwStat"
theme_override_font_sizes/font_size = 14

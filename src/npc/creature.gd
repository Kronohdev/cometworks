@tool
class_name Cometling
extends Node3D
## One Cometling (PT: Cometinho), the chibi species that crews MARGIN's rockets.
## Rig: scenes/npc/creature.tscn (generated by tools/creature_gen.py): a skeleton-free
## hierarchy of Node3D pivots, one voxel mesh per limb. This script drives every pivot
## procedurally each frame (no AnimationPlayer, no bones):
##   - idle: breathing, bob, blinking (sometimes double, often on a glance), eye darts,
##     glancing, antenna pulse, weight shifts and random habits (look around, head tilt,
##     ear flick, antenna boing, toe bounce, tail wag, shy foot scuff, little hops, yawns,
##     stretches); personality_seed and mood change the tempo so a crowd never syncs
##   - walking: squash & stretch steps, arm swing, body sway, a run above run_speed, a
##     lean into turns with the head leading; set_move_velocity()
##   - secondary motion: ears, antenna, tail, scarf and body lean on damped springs
##   - look-at: the head turns first toward a point, the body follows a little later
##   - loop actions: see LOOP_ACTIONS; one-shots on top: see ONESHOTS
##   - faces: expressions (set_expression) and mood tint the idle face
##
## Public API (all names stable; scenes, campus walkers, crew portraits and the menu shots
## call these):
##   play(action, duration = -1)       loop action or one-shot (duration only for one-shots)
##   play_sequence([one-shots...])     chain one-shots
##   current_action() / is_busy()      what is playing
##   has_action(action) / all_actions() lookup helpers for tools and UIs
##   stop_shot()                       cancels the running one-shot and the queue
##   set_move_velocity(world_velocity) walk / run from the parent's motion
##   look_at_point(p, weight) / clear_look()
##   react(event)                      hangar / campus events (list below)
##   poke()                            a random cute reaction (clicks, hovers)
##   show_emote(name, duration)        speech bubble (EMOTES)
##   set_expression(name, duration=-1) / clear_expression() / current_expression()
##   set_colors(body, spot, glow) / effective_glow(); exports role, body_color, spot_color,
##   glow_color, mood, personality_seed, start_action and the tunables below
##   advance(dt)                       steps the animation by hand (with paused = true)
##
## Loops:    idle, sit, look_up, work_hammer, work_scan, carry, clipboard, talk, dance,
##           sleep (nap with zZ), think (paw on chin), sad (slump), work_type (keyboard),
##           work_wrench (ratchet)
## One-shots: wave, cheer, jump, surprise, nod, spin, hop, clap, celebrate, startled,
##           point, salute, bow, shrug, laugh, sigh, shake_head, yawn, stretch
## Faces:    neutral, happy, joy, content, sad, surprised, sleepy, grumpy, worried
## Hangars call react("part_placed") etc. Every Cometling also listens to the
## NpcEvents bus (src/npc/npc_events.gd) when listen_to_events is on.

signal action_finished(action: String)
## An emote bubble popped (show_emote): the sound player chirps from it.
signal emoted(emote: String)

const ROLES := ["ground", "pilot", "engineer", "scientist"]
const LOOP_ACTIONS := ["idle", "sit", "look_up", "work_hammer", "work_scan", "carry", "clipboard", "talk", "dance",
	"sleep", "think", "sad", "work_type", "work_wrench"]
const ONESHOTS := {"wave": 2.2, "cheer": 2.4, "jump": 1.0, "surprise": 1.1, "nod": 0.9, "spin": 1.2,
	"hop": 0.6, "clap": 2.0, "celebrate": 2.6, "startled": 1.5, "point": 1.8, "salute": 1.6, "bow": 1.5,
	"shrug": 1.4, "laugh": 1.8, "sigh": 2.2, "shake_head": 1.2, "yawn": 2.6, "stretch": 2.2}
const EMOTES := ["heart", "star", "exclaim", "question", "note", "wrench", "rocket", "zzz",
	"idea", "sweat", "happy", "sparkle", "chat", "fire", "check", "planet"]
const EXPRESSIONS := ["neutral", "happy", "joy", "content", "sad", "surprised", "sleepy", "grumpy", "worried"]
## Role -> antenna glow colour (palette: ACCENT, HAZARD, ACCENT_2, SUCCESS).
const ROLE_GLOW := {"pilot": Color("#f59a36"), "engineer": Color("#f2b705"),
	"scientist": Color("#5fb0d8"), "ground": Color("#7ee08a")}
## Loops that are done standing (or sitting) in place: while walking the legs keep walking.
const _STATIONARY := ["sit", "sleep", "work_hammer", "work_scan", "clipboard", "talk", "dance", "think",
	"work_type", "work_wrench"]
const _FIDGETS := ["look_around", "head_tilt", "toe_bounce", "tail_wag", "shy", "weight_shift",
	"ear_flick", "antenna_boing", "hop", "yawn", "stretch", "sigh"]
const _FIDGET_LEN := {"look_around": 2.6, "head_tilt": 1.8, "toe_bounce": 1.6, "tail_wag": 1.4, "shy": 3.6}


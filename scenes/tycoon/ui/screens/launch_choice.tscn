[gd_scene format=3]

[ext_resource type="Theme" path="res://ui/cometworks_theme.tres" id="cw_theme"]
[ext_resource type="Script" path="res://src/tycoon/ui/project/launch_choice_screen.gd" id="1_scr"]
[ext_resource type="Texture2D" path="res://ui/cometworks/icons/control.svg" id="2_pilot"]
[ext_resource type="Texture2D" path="res://ui/cometworks/icons/dice.svg" id="3_auto"]
[ext_resource type="Script" path="res://src/tycoon/ui/motion/cw_button_motion.gd" id="cwm_btn"]
[ext_resource type="Script" path="res://src/tycoon/ui/motion/cw_screen_transition.gd" id="cwm_screen"]
[ext_resource type="Script" path="res://src/tycoon/ui/motion/cw_stagger.gd" id="cwm_stagger"]

[node name="LaunchChoice" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme = ExtResource("cw_theme")
script = ExtResource("1_scr")

[node name="Scrim" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.1059, 0.0941, 0.2706, 0.6)

[node name="Panel" type="PanelContainer" parent="."]
layout_mode = 1
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -420.0
offset_top = -235.0
offset_right = 420.0
offset_bottom = 235.0
grow_horizontal = 2
grow_vertical = 2
theme_type_variation = &"CwPanelTop"

[node name="Margin" type="MarginContainer" parent="Panel"]
layout_mode = 2
theme_override_constants/margin_left = 18
theme_override_constants/margin_top = 14
theme_override_constants/margin_right = 18
theme_override_constants/margin_bottom = 14

[node name="VBox" type="VBoxContainer" parent="Panel/Margin"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="Header" type="HBoxContainer" parent="Panel/Margin/VBox"]
layout_mode = 2
theme_override_constants/separation = 16

[node name="Titles" type="VBoxContainer" parent="Panel/Margin/VBox/Header"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 2

[node name="Caption" type="Label" parent="Panel/Margin/VBox/Header/Titles"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"CwCaps"
theme_override_font_sizes/font_size = 13
text = "DEM-01 · Demo satellite → Low orbit · rocket Andorinha"
text_overrun_behavior = 3

[node name="Title" type="Label" parent="Panel/Margin/VBox/Header/Titles"]
layout_mode = 2
theme_type_variation = &"CwTitle"
theme_override_font_sizes/font_size = 28
text = "TY_HG_CHOICE_TITLE"

[node name="Hint" type="Label" parent="Panel/Margin/VBox/Header/Titles"]
layout_mode = 2
theme_type_variation = &"CwDim"
theme_override_font_sizes/font_size = 13
text = "TY_HG_CHOICE_HINT"
autowrap_mode = 3

[node name="Close" type="Button" parent="Panel/Margin/VBox/Header"]
unique_name_in_owner = true
custom_minimum_size = Vector2(36, 36)
layout_mode = 2
size_flags_vertical = 0
tooltip_text = "TY_HG_CHOICE_LATER"
focus_mode = 0
theme_type_variation = &"CwKey"
text = "×"

[node name="Sep" type="HSeparator" parent="Panel/Margin/VBox"]
layout_mode = 2

[node name="Choices" type="HBoxContainer" parent="Panel/Margin/VBox"]
layout_mode = 2
size_flags_vertical = 3
theme_override_constants/separation = 16

[node name="PilotCard" type="PanelContainer" parent="Panel/Margin/VBox/Choices"]
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"CwBox"

[node name="Margin" type="MarginContainer" parent="Panel/Margin/VBox/Choices/PilotCard"]
layout_mode = 2
theme_override_constants/margin_left = 16
theme_override_constants/margin_top = 14
theme_override_constants/margin_right = 16
theme_override_constants/margin_bottom = 14

[node name="VBox" type="VBoxContainer" parent="Panel/Margin/VBox/Choices/PilotCard/Margin"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="Head" type="HBoxContainer" parent="Panel/Margin/VBox/Choices/PilotCard/Margin/VBox"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="Icon" type="TextureRect" parent="Panel/Margin/VBox/Choices/PilotCard/Margin/VBox/Head"]
custom_minimum_size = Vector2(44, 44)
layout_mode = 2
mouse_filter = 2
texture = ExtResource("2_pilot")
expand_mode = 1
stretch_mode = 5

[node name="Name" type="Label" parent="Panel/Margin/VBox/Choices/PilotCard/Margin/VBox/Head"]
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"CwTitle"
theme_override_font_sizes/font_size = 21
text = "TY_HG_CHOICE_PILOT"
autowrap_mode = 3

[node name="Desc" type="Label" parent="Panel/Margin/VBox/Choices/PilotCard/Margin/VBox"]
custom_minimum_size = Vector2(0, 64)
layout_mode = 2
size_flags_vertical = 3
theme_type_variation = &"CwBody"
theme_override_font_sizes/font_size = 14
text = "TY_HG_CHOICE_PILOT_DESC"
autowrap_mode = 3

[node name="PilotGoal" type="Label" parent="Panel/Margin/VBox/Choices/PilotCard/Margin/VBox"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"CwStat"
